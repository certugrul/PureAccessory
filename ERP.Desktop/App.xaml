<Application x:Class="ERP.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#111827"/>
    <SolidColorBrush x:Key="PageBrush" Color="#F3F4F6"/>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  </ResourceDictionary></Application.Resources>
</Application>
