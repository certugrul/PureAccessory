<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="NavButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#D1D5DB"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="22,14"/><Setter Property="FontSize" Value="15"/>
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1F2937"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
  </Style>
</ResourceDictionary>
