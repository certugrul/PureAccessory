<Window x:Class="ERP.Desktop.Views.StockAdjustmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Depo Stok Hareketi (Giriş / Çıkış)"
        Height="460" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" WindowStyle="SingleBorderWindow">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Başlık -->
            <RowDefinition Height="*"/>    <!-- Form Alanları -->
            <RowDefinition Height="Auto"/> <!-- Butonlar -->
        </Grid.RowDefinitions>

        <!-- 1. BAŞLIK -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="14,12" Margin="0,0,0,16"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" Text="📦 Depo Stok Hareketi" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock x:Name="TxtSubTitle" Text="Depoya manuel stok girişi veya stok çıkışı yapın" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2. FORM ALANLARI -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,16"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <!-- İşlem Türü (Giriş / Çıkış) -->
                <TextBlock Text="İşlem Türü" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="RbStockIn" Content="📥 Stok Girişi (+)" IsChecked="True" Checked="OperationType_Changed"
                                 FontWeight="Bold" Foreground="#059669" FontSize="13" Margin="0,0,20,0" Cursor="Hand"/>
                    <RadioButton x:Name="RbStockOut" Content="📤 Stok Çıkışı (-)" Checked="OperationType_Changed"
                                 FontWeight="Bold" Foreground="#DC2626" FontSize="13" Cursor="Hand"/>
                </StackPanel>

                <!-- Depo Seçimi -->
                <TextBlock Text="Hedef Depo" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbWarehouse" DisplayMemberPath="Name" SelectedValuePath="Id" Height="36"
                          FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                <!-- Ürün Seçimi -->
                <TextBlock Text="Ürün" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbProducts" DisplayMemberPath="Name" SelectedValuePath="Id" Height="36"
                          FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,12" SelectionChanged="CmbProducts_SelectionChanged"/>

                <!-- Mevcut Stok Bilgisi -->
                <TextBlock x:Name="TxtCurrentStock" Text="Mevcut Stok: - Adet" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,-8,0,10"/>

                <!-- Adet Girişi -->
                <TextBlock Text="Miktar (Adet)" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtQuantity" Height="36" FontSize="14" FontWeight="Bold" Foreground="#0F172A"
                         VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12" Text="1"/>

                <!-- Açıklama / Sebep -->
                <TextBlock Text="Açıklama / Sebep" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDescription" Height="34" FontSize="12" VerticalContentAlignment="Center"
                         Padding="8,0" Text="Manuel Stok Güncelleme"/>
            </StackPanel>
        </Border>

        <!-- 3. AKSİYON BUTONLARI -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Vazgeç" Click="Cancel_Click" Width="95" Height="38" Margin="0,0,10,0"
                    Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Grid.Column="2" x:Name="BtnSave" Content="💾 Hareketi Kaydet" Click="Save_Click" Width="150" Height="38"
                    Background="#059669" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
