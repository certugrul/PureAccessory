<Window x:Class="ERP.Desktop.Views.DebtHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Borç Hareket ve Faiz Geçmişi" Width="840" Height="560"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Üst Başlık & Özet -->
            <RowDefinition Height="*"/>    <!-- Sekmeler & Tablolar -->
            <RowDefinition Height="Auto"/> <!-- Kapat Butonu -->
        </Grid.RowDefinitions>

        <!-- ÜST PANEL -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtTitle" Text="Borç Adı" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="TxtSubtitle" Text="Alacaklı / Kurum" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="Kalan Toplam Borç" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TxtTotalDebt" Text="₺0,00" FontSize="18" FontWeight="Bold" Foreground="#F87171" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SEKMELER -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
            <TabControl BorderThickness="0" Background="Transparent">
                <!-- TAB 1: TÜM HAREKETLER -->
                <TabItem Header="📋 Bakiye &amp; İşlem Hareketleri">
                    <DataGrid x:Name="DgTransactions" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" BorderBrush="#E2E8F0" BorderThickness="1"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              Background="White" RowHeight="36" FontSize="12" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tarih" Binding="{Binding FormattedDate}" Width="130"/>
                            <DataGridTextColumn Header="İşlem Türü" Binding="{Binding TransactionType}" Width="120" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Tutar" Binding="{Binding FormattedAmount}" Width="100" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Anapara" Binding="{Binding FormattedPrincipalChange}" Width="110"/>
                            <DataGridTextColumn Header="Faiz" Binding="{Binding FormattedInterestChange}" Width="95"/>
                            <DataGridTextColumn Header="Vergi" Binding="{Binding FormattedTaxChange}" Width="95"/>
                            <DataGridTextColumn Header="Kalan Bakiye" Binding="{Binding FormattedNewBalance}" Width="110" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- TAB 2: FAİZ TAHAKKUKLARI -->
                <TabItem Header="📈 Faiz Tahakkukları">
                    <DataGrid x:Name="DgAccruals" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" BorderBrush="#E2E8F0" BorderThickness="1"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              Background="White" RowHeight="36" FontSize="12" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dönem" Binding="{Binding FormattedPeriod}" Width="180"/>
                            <DataGridTextColumn Header="Anapara" Binding="{Binding FormattedPrincipal}" Width="120"/>
                            <DataGridTextColumn Header="Aylık Faiz %" Binding="{Binding Rate, StringFormat='%{0:N2}'}" Width="90"/>
                            <DataGridTextColumn Header="Net Faiz" Binding="{Binding FormattedInterest}" Width="110" Foreground="#D97706" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="KKDF + BSMV" Binding="{Binding FormattedTax}" Width="110" Foreground="#D97706"/>
                            <DataGridTextColumn Header="Toplam Tahakkuk" Binding="{Binding FormattedTotalAccrual}" Width="130" FontWeight="Bold" Foreground="#DC2626"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- TAB 3: ÖDEMELER -->
                <TabItem Header="💳 Yapılan Ödemeler">
                    <DataGrid x:Name="DgPayments" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" BorderBrush="#E2E8F0" BorderThickness="1"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              Background="White" RowHeight="36" FontSize="12" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ödeme Tarihi" Binding="{Binding FormattedDate}" Width="140"/>
                            <DataGridTextColumn Header="Tür" Binding="{Binding PaymentType}" Width="100"/>
                            <DataGridTextColumn Header="Ödenen Tutar" Binding="{Binding FormattedPaid}" Width="130" FontWeight="Bold" Foreground="#059669"/>
                            <DataGridTextColumn Header="İşleyen Kullanıcı" Binding="{Binding CreatedBy}" Width="130"/>
                            <DataGridTextColumn Header="Notlar" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- KAPAT BUTONU -->
        <Border Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Kapat" Click="Close_Click" Width="100" Height="36" HorizontalAlignment="Right"
                    Background="#E2E8F0" Foreground="#334155" FontWeight="SemiBold" FontSize="12"
                    Cursor="Hand" BorderThickness="0">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </Border>
    </Grid>
</Window>
