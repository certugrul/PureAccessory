<Window x:Class="ERP.Desktop.Views.EditProductPriceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ürün Satış Fiyatını Değiştir" Height="320" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" ShowInTaskbar="False">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✏️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtProductName" Text="Ürün Adı" FontSize="17" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock x:Name="TxtProductCodeInfo" Text="Kod: PRD-0001 | Mevcut Fiyat: ₺0,00" FontSize="12" Foreground="#64748B" Margin="28,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- FORM -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Yeni Satış Fiyatı (₺) *" FontSize="13" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="12,0">
                        <TextBlock Text="₺" FontSize="18" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                    </Border>
                    <TextBox x:Name="TxtNewPrice" Grid.Column="1" Height="44" FontSize="20" FontWeight="Bold" Foreground="#0F172A"
                             Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#2563EB" BorderThickness="0,1,1,1"/>
                </Grid>

                <!-- Hızlı Butonlar -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="+5 ₺" Click="AdjustPrice_Click" Tag="5" Margin="0,0,6,0" Padding="10,5" Background="#F1F5F9" FontWeight="SemiBold" FontSize="12" BorderBrush="#CBD5E1" Cursor="Hand"/>
                    <Button Content="+10 ₺" Click="AdjustPrice_Click" Tag="10" Margin="0,0,6,0" Padding="10,5" Background="#F1F5F9" FontWeight="SemiBold" FontSize="12" BorderBrush="#CBD5E1" Cursor="Hand"/>
                    <Button Content="+50 ₺" Click="AdjustPrice_Click" Tag="50" Margin="0,0,6,0" Padding="10,5" Background="#F1F5F9" FontWeight="SemiBold" FontSize="12" BorderBrush="#CBD5E1" Cursor="Hand"/>
                    <Button Content="+100 ₺" Click="AdjustPrice_Click" Tag="100" Padding="10,5" Background="#F1F5F9" FontWeight="SemiBold" FontSize="12" BorderBrush="#CBD5E1" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- BUTONLAR -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="✕ Vazgeç" Click="Cancel_Click" Margin="0,0,8,0"
                    Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Padding="0,10"
                    BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
            </Button>

            <Button Grid.Column="1" Content="💾 Fiyatı Güncelle" Click="Save_Click" Margin="8,0,0,0"
                    Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="13" Padding="0,10"
                    BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
