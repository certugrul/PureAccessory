<Window x:Class="ERP.Desktop.Views.DailyReceiptBreakdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🧾 Günlük Fiş &amp; Satılan Ürünler Dökümü"
        Height="720" Width="1050" MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC"
        KeyDown="Window_KeyDown">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Üst Başlık & Tarih Seçimi -->
            <RowDefinition Height="Auto"/> <!-- 2. Özet İstatistik Kartları -->
            <RowDefinition Height="*"/>    <!-- 3. Ana Tablolar (Satılan Ürünler / Fişler) -->
            <RowDefinition Height="Auto"/> <!-- 4. Alt Durum Çubuğu -->
        </Grid.RowDefinitions>

        <!-- 1. ÜST BAŞLIK & TARİH SEÇİM ÇUBUĞU -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,0,14"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: Başlık ve Açıklama -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧾 Günlük Fiş &amp; Satılan Ürünler Dökümü" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <Border x:Name="ActiveDateBadge" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtActiveDateHeader" Text="08.10.2026" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Seçilen tarihte kasadan satılan ürünlerin adetleri, tutarları, ciro payları ve kesilen tüm fişlerin detayları" 
                               FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Sağ: Tarih Değiştirme ve Aksiyon Butonları -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tarih Değiştirme Kontrol Grubu -->
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="6,3" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="◀" Click="PrevDay_Click" Background="Transparent" BorderThickness="0" FontWeight="Bold" FontSize="13" Foreground="#475569" Padding="6,2" Cursor="Hand" ToolTip="Bir önceki gün"/>
                            <DatePicker x:Name="SelectedDatePicker" Width="125" Height="30" Margin="4,0" VerticalContentAlignment="Center" SelectedDateChanged="SelectedDatePicker_SelectedDateChanged"/>
                            <Button Content="▶" Click="NextDay_Click" Background="Transparent" BorderThickness="0" FontWeight="Bold" FontSize="13" Foreground="#475569" Padding="6,2" Cursor="Hand" ToolTip="Bir sonraki gün"/>
                            <Button Content="Bugün" Click="Today_Click" Background="#E2E8F0" BorderThickness="0" FontWeight="SemiBold" FontSize="11" Foreground="#1E293B" Padding="8,4" Margin="4,0,0,0" Cursor="Hand" ToolTip="Bugünün tarihine git">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- PDF Çıktı Butonu -->
                    <Button Content="🖨️ PDF Dökümü Al" Click="ExportPdf_Click"
                            Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="12"
                            Padding="14,8" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand" ToolTip="Günün fiş dökümünü ve satılan ürünler raporunu PDF olarak yazdır/kaydet">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Yenile Butonu -->
                    <Button Content="🔄 Yenile" Click="Refresh_Click"
                            Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" FontSize="12"
                            Padding="12,8" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand" ToolTip="Verileri yeniden yükle (F5)">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. ÖZET İSTATİSTİK KARTLARI (KPIs) -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Toplam Fiş Sayısı -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🧾 TOPLAM FİŞ" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtTotalSalesCount" Text="0 Fiş" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtSalesSubInfo" Text="Günün tamamlanan satışları" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 2. Toplam Satılan Ürün Adedi -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📦 SATILAN ÜRÜN ADEDİ" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtTotalQuantitySold" Text="0 Adet" FontSize="20" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtQuantitySubInfo" Text="Fiziksel ürün çıkışı toplamı" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 3. Satılan Ürün Çeşidi -->
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🏷️ ÜRÜN ÇEŞİDİ" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtDistinctProductCount" Text="0 Çeşit" FontSize="20" FontWeight="Bold" Foreground="#4F46E5" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtDistinctSubInfo" Text="Farklı kalem ürün sayısı" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 4. Toplam Satış Cirosu & Tahsilat Dağılımı -->
            <Border Grid.Column="3" Background="White" CornerRadius="10" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="💰 GÜNLÜK TOPLAM CİRO" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock Grid.Row="1" x:Name="TxtTotalRevenue" Text="₺0,00" FontSize="20" FontWeight="Bold" Foreground="#2563EB" Margin="0,2,0,4"/>
                    <!-- Ödeme Dağılımı Rozetleri -->
                    <WrapPanel Grid.Row="2">
                        <Border Background="#F1F5F9" CornerRadius="4" Padding="5,1" Margin="0,0,6,2">
                            <TextBlock x:Name="TxtCashShare" Text="💵 Nakit: ₺0" FontSize="10" FontWeight="SemiBold" Foreground="#334155"/>
                        </Border>
                        <Border Background="#F1F5F9" CornerRadius="4" Padding="5,1" Margin="0,0,6,2">
                            <TextBlock x:Name="TxtCardShare" Text="💳 Kart: ₺0" FontSize="10" FontWeight="SemiBold" Foreground="#334155"/>
                        </Border>
                        <Border Background="#F1F5F9" CornerRadius="4" Padding="5,1" Margin="0,0,0,2">
                            <TextBlock x:Name="TxtOnAccountShare" Text="📝 Veresiye: ₺0" FontSize="10" FontWeight="SemiBold" Foreground="#334155"/>
                        </Border>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. ANA İÇERİK SEKMELERİ (ÜRÜN BAZLI DÖKÜM / FİŞ BAZLI DÖKÜM) -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="16,8"/>
                    </Style>
                </TabControl.Resources>

                <!-- SEKME 1: SATILAN ÜRÜNLER ÖZETİ (ADET VE TUTAR DETAYI) -->
                <TabItem Header="📦 Satılan Ürünler Detayı &amp; Adetleri">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Arama Filtresi -->
                            <RowDefinition Height="*"/>    <!-- Ürünler Tablosu -->
                            <RowDefinition Height="Auto"/> <!-- Tablo Altı Toplam Bandı -->
                        </Grid.RowDefinitions>

                        <!-- Arama Kutusu -->
                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtProductFilter" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                         FontSize="13" VerticalContentAlignment="Center" TextChanged="ProductFilter_TextChanged"
                                         ToolTip="Ürün adı veya koduna göre anlık arama yapın..."/>
                                <TextBlock Grid.Column="2" x:Name="TxtProductFilterCount" Text="0 Kalem Listelendi" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Ürünler DataGrid -->
                        <DataGrid Grid.Row="1" x:Name="ProductsGrid" AutoGenerateColumns="False" Background="White"
                                  BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="38" ColumnHeaderHeight="34"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                  HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ürün Kodu" Binding="{Binding ProductCode}" Width="120"/>
                                <DataGridTextColumn Header="Ürün Adı" Binding="{Binding ProductName}" Width="*" FontWeight="SemiBold"/>

                                <!-- Satılan Adet (Belirgin Rozet) -->
                                <DataGridTemplateColumn Header="Satılan Adet" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedQuantity}" FontWeight="Bold" Foreground="#059669" FontSize="12"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding FormattedUnitPrice}" Width="105"/>
                                <DataGridTextColumn Header="KDV Tutarı" Binding="{Binding FormattedVatTotal}" Width="95"/>
                                <DataGridTextColumn Header="Toplam Tutar" Binding="{Binding FormattedTotalRevenue}" Width="120" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Fiş Sayısı" Binding="{Binding ReceiptCount}" Width="85"/>
                                <DataGridTextColumn Header="Ciro Payı" Binding="{Binding FormattedShare}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Tablo Altı Toplam Bandı -->
                        <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Seçilen günde satılan tüm ürünlerin toplam dökümüdür." FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="Toplam Adet:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtProductsFooterQuantity" Text="0 Adet" FontSize="13" FontWeight="Bold" Foreground="#059669"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Genel Toplam Tutar:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtProductsFooterRevenue" Text="₺0,00" FontSize="14" FontWeight="Bold" Foreground="#2563EB"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- SEKME 2: GÜNLÜK FİŞLER & FİŞ DETAYI (MASTER - DETAIL) -->
                <TabItem Header="🧾 Günün Fişleri &amp; Kalem Detayları">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/> <!-- Sol: Fiş Listesi -->
                            <ColumnDefinition Width="*"/>   <!-- Sağ: Seçili Fişin Ürünleri -->
                        </Grid.ColumnDefinitions>

                        <!-- SOL: FİŞ LİSTESİ -->
                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="📋 Kesilen Fişler Listesi" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock x:Name="TxtReceiptsCountBadge" Text="0 Fiş" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                </Grid>

                                <DataGrid Grid.Row="1" x:Name="ReceiptsGrid" AutoGenerateColumns="False" Background="White"
                                          BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="36" ColumnHeaderHeight="32"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                          HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                                          SelectionChanged="ReceiptsGrid_SelectionChanged">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                            <Setter Property="Foreground" Value="#475569"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Padding" Value="6,0"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Fiş No" Binding="{Binding FormattedId}" Width="65" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="Saat" Binding="{Binding FormattedTime}" Width="70"/>
                                        <DataGridTextColumn Header="Ödeme" Binding="{Binding PaymentTypeBadge}" Width="105"/>
                                        <DataGridTextColumn Header="Kalem" Binding="{Binding FormattedItemCount}" Width="75"/>
                                        <DataGridTextColumn Header="Adet" Binding="{Binding FormattedQuantity}" Width="75" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="Tutar" Binding="{Binding FormattedTotal}" Width="*" FontWeight="Bold"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- SAĞ: SEÇİLİ FİŞİN KALEM DETAYI -->
                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Seçili Fiş Başlığı -->
                                    <RowDefinition Height="*"/>    <!-- Kalemler Tablosu -->
                                    <RowDefinition Height="Auto"/> <!-- Fiş Özeti -->
                                </Grid.RowDefinitions>

                                <!-- Seçili Fiş Başlığı -->
                                <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="TxtSelectedReceiptTitle" Text="Lütfen bir fiş seçin" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                            <TextBlock x:Name="TxtSelectedReceiptSub" Text="Soldaki listeden fişe tıklayarak kalemleri görebilirsiniz" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                        <Border x:Name="SelectedReceiptBadge" Grid.Column="1" Background="#EFF6FF" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtSelectedReceiptPayment" Text="-" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Kalemler Tablosu -->
                                <DataGrid Grid.Row="1" x:Name="ReceiptItemsGrid" AutoGenerateColumns="False" Background="White"
                                          BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="34" ColumnHeaderHeight="30"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                          HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                            <Setter Property="Foreground" Value="#475569"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Padding" Value="6,0"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ürün Adı" Binding="{Binding ProductName}" Width="*"/>
                                        <DataGridTextColumn Header="Adet" Binding="{Binding Quantity}" Width="55" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="Fiyat" Binding="{Binding UnitPrice, StringFormat=₺{0:N2}}" Width="70"/>
                                        <DataGridTextColumn Header="Toplam" Binding="{Binding LineTotal, StringFormat=₺{0:N2}}" Width="80" FontWeight="Bold"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Fiş Alt Özeti -->
                                <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10,8" Margin="0,8,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="TxtReceiptFooterItemsCount" Text="0 Kalem Ürün" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="Fiş Tutarı:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="TxtReceiptFooterTotal" Text="₺0,00" FontSize="15" FontWeight="Bold" Foreground="#2563EB"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- 4. ALT KAPAT VE BİLGİ BANDI -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="💡 İpucu: Listede bir ürünü aramak için arama çubuğunu kullanabilir, fiş dökümünü PDF olarak alabilirsiniz." 
                       FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
            <Button Content="✕ Kapat" Click="Close_Click" HorizontalAlignment="Right"
                    Background="#E2E8F0" Foreground="#334155" FontWeight="Bold" FontSize="12"
                    Padding="20,8" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
