<Window x:Class="ERP.Desktop.Views.PhoneScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📱 Telefonu Barkod Okuyucu Olarak Bağla" Height="680" Width="820"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8FAFC" ShowInTaskbar="False">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Başlık -->
            <RowDefinition Height="*"/>    <!-- Ana İçerik (QR + Bilgiler) -->
            <RowDefinition Height="Auto"/> <!-- Alt Aksiyonlar -->
        </Grid.RowDefinitions>

        <!-- 1. ÜST BAŞLIK -->
        <Border Grid.Row="0" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📱" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Kablosuz Telefon Barkod Okuyucu" FontSize="22" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Android veya iPhone telefonunuzun kamerasını yerel ağ üzerinden kablosuz barkod okuyucu yapın." 
                               FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Canlı Bağlantı Durumu Rozeti -->
                <Border Grid.Column="1" x:Name="StatusBadge" Background="#FEF2F2" CornerRadius="8" Padding="14,8" BorderBrush="#FECACA" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusDot" Text="🔴" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Telefon Bekleniyor..." FontSize="13" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. ANA PANEL: SOLDA QR KOD, SAĞDA BİLGİLER & CİHAZ YÖNETİMİ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SOL: QR KOD KARTI -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,16,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Kamerayla QR Kodu Okutun" FontSize="15" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                    <TextBlock Text="Telefon tarayıcısında anında açılır" FontSize="12" Foreground="#64748B" Margin="0,2,0,14" HorizontalAlignment="Center"/>

                    <!-- QR Kod Görseli -->
                    <Border Background="#F8FAFC" CornerRadius="10" Padding="10" BorderBrush="#CBD5E1" BorderThickness="1" HorizontalAlignment="Center">
                        <Image x:Name="ImgQrCode" Width="220" Height="220" Stretch="Uniform"/>
                    </Border>

                    <!-- Güvenlik Tokenı Rozeti -->
                    <Border Background="#EFF6FF" CornerRadius="6" Padding="10,5" Margin="0,10,0,0" BorderBrush="#BFDBFE" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtTokenBadge" Text="Güvenlik Tokenı: - " FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/>
                    </Border>

                    <!-- Cloudflare HTTPS Durum Rozeti -->
                    <Border x:Name="HttpsStatusCard" Background="#F0FDF4" CornerRadius="8" Padding="10,6" Margin="0,8,0,0" BorderBrush="#BBF7D0" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🔒" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Resmi Cloudflare HTTPS Aktif" FontSize="11" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- HTTPS Tünel Aç/Kapa Butonu -->
                    <Button x:Name="BtnToggleHttps" Content="🌐 iPhone Canlı Kamera İçin HTTPS Başlat" Click="ToggleHttps_Click"
                            Margin="0,10,0,0" Padding="10,8" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand" BorderThickness="0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- SAĞ: BAĞLANTI AYARLARI, CİHAZ LİSTESİ VE TALİMATLAR -->
            <StackPanel Grid.Column="1">
                <!-- Adres ve Ağ Seçimi Kartı -->
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Bilgisayar Ağ Kartı (Yerel Ağda Telefonla Aynı Olmalı):" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbNetworkAdapter" Height="36" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"
                                  SelectionChanged="CmbNetworkAdapter_SelectionChanged"/>

                        <TextBlock Text="Aktif Bağlantı Adresi (QR Kod Linki)" FontSize="13" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtServerUrl" Grid.Column="0" Height="38" Padding="10,6" FontSize="13" 
                                     IsReadOnly="True" VerticalContentAlignment="Center" Background="#F8FAFC" Foreground="#0F172A" FontWeight="Medium"/>
                            <Button Grid.Column="1" Content="📋 Kopyala" Click="CopyUrl_Click" Margin="8,0,0,0" Padding="14,0"
                                    Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" BorderBrush="#CBD5E1" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Bağlı Telefon Kartı -->
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Aktif Bağlı Cihaz" FontSize="13" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10"/>
                        
                        <Grid x:Name="DeviceDetailsPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtConnectedDeviceName" Text="Apple iPhone" FontSize="16" FontWeight="Bold" Foreground="#059669"/>
                                <TextBlock x:Name="TxtConnectedDeviceInfo" Text="IP: 192.168.1.102 | Saat: 20:05:00" FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                                <TextBlock x:Name="TxtScanCount" Text="Okutulan Barkod: 0 Adet" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="❌ Bağlantıyı Kes" Click="DisconnectDevice_Click"
                                    Background="#FEE2E2" Foreground="#DC2626" FontWeight="Bold" Padding="14,8" BorderBrush="#FECACA" Cursor="Hand" VerticalAlignment="Center">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="TxtNoDevicePrompt" Text="Henüz bir telefon bağlanmadı. Telefonunuzla soldaki QR kodu okutun." 
                                   FontSize="13" Foreground="#94A3B8" FontStyle="Italic"/>
                    </StackPanel>
                </Border>

                <!-- Kurulum Adımları & Bilgilendirme -->
                <Border Background="#F1F5F9" CornerRadius="12" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="💡 Nasıl Kullanılır?" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                        <TextBlock Text="1. Soldaki QR kodu telefonunuzun kamerasıyla taratıp tarayıcıda açın." FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                        <TextBlock Text="2. Barkodu kameraya tuttuğunuz anda ürün bilgisayardaki satış sepetine eklenir." FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                        <TextBlock Text="🍏 iPhone Safari Kullanıcıları:" FontSize="12" FontWeight="Bold" Foreground="#2563EB" Margin="0,6,0,2"/>
                        <TextBlock Text="Apple HTTP bağlantısında canlı kamerayı kilitlediği için soldaki 'HTTPS Başlat' butonuna basın. Cloudflare resmi SSL linki üretilir ve iPhone'da canlı arka kamera anında açılır." FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        
                        <Separator Margin="0,8,0,8"/>
                        
                        <!-- Güvenlik Duvarı İzni Uyarısı -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Telefon yerel ağda bağlanamazsa Windows Güvenlik Duvarı engelliyor olabilir:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="🛡️ Güvenlik Duvarı İzni Ver" Click="OpenFirewallRule_Click" Background="Transparent" Foreground="#2563EB" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 3. ALT AKSİYONLAR -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="🔄 Sunucuyu Yeniden Başlat" Click="RestartServer_Click" Padding="16,9"
                    Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" BorderBrush="#CBD5E1" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
            </Button>

            <Button Grid.Column="2" Content="✔️ Tamam (Pencereyi Kapat - Arka Planda Çalışır)" Click="CloseWindow_Click" Padding="22,9"
                    Background="#2563EB" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
