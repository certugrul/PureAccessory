<Page x:Class="ERP.Desktop.Views.ReportsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F8FAFC">

    <Grid Margin="10,5,10,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Başlık -->
            <RowDefinition Height="*"/>    <!-- Sekmeler -->
        </Grid.RowDefinitions>

        <!-- 1. ÜST BAŞLIK -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,15"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Raporlar, Analiz &amp; Gün Sonu Arşivi" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Z ve X raporları, detaylı satış, aylık/yıllık ciro ve kâr/zarar analizleri, canlı sütun grafikleri ve PDF dökümleri" 
                               FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="8" Padding="12,6" BorderBrush="#BFDBFE" BorderThickness="1">
                    <TextBlock Text="📊 Grafik &amp; PDF Motoru Aktif" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- 2. ANA SEKMELER -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- SEKME 1: RAPORLAR VE ANALİZ -->
            <TabItem Header="📊 Finansal &amp; Mali Raporlar" FontSize="14" FontWeight="SemiBold" Padding="16,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Kategori Butonları (Günlük vs Genel) -->
                            <RowDefinition Height="Auto"/> <!-- Rapor Seçim Kartları -->
                            <RowDefinition Height="Auto"/> <!-- Filtre Çubuğu & Filtrele Butonu -->
                            <RowDefinition Height="Auto"/> <!-- Aksiyon Çubuğu (PDF, Gün Sonu) -->
                            <RowDefinition Height="Auto"/> <!-- Sütun Grafiği ve KPI Kartları -->
                            <RowDefinition Height="*"/>    <!-- Önizleme & Detay Tablosu -->
                        </Grid.RowDefinitions>

                        <!-- KATEGORİ SEÇİM BUTONLARI (GÜNLÜK RAPORLAR vs GENEL RAPORLAR) -->
                        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="14,10" Margin="0,0,0,12"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnCategoryDaily" Grid.Column="0" Click="CategoryDaily_Click" Margin="0,0,6,0"
                                        Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="14" Padding="0,12"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="📅" FontSize="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="GÜNLÜK RAPORLAR (Z &amp; X Raporu)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnCategoryGeneral" Grid.Column="1" Click="CategoryGeneral_Click" Margin="6,0,0,0"
                                        Background="#F1F5F9" Foreground="#475569" FontWeight="Bold" FontSize="14" Padding="0,12"
                                        BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="📊" FontSize="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="GENEL RAPORLAR (Satış, Ciro, Kâr/Zarar)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- GÜNLÜK RAPOR KARTLARI (Z ve X) -->
                        <Grid x:Name="PanelDailyCards" Grid.Row="1" Margin="0,0,0,12" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. Z Raporu -->
                            <Border x:Name="CardZReport" Grid.Column="0" MouseLeftButtonDown="SelectReport_Click" Tag="Z"
                                    Background="#EFF6FF" CornerRadius="12" Margin="0,0,8,0" Padding="16" 
                                    BorderBrush="#2563EB" BorderThickness="2" Cursor="Hand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚡" FontSize="22" Margin="0,0,8,0"/>
                                            <TextBlock Text="Z Raporu (Gün Sonu Resmî Kapanış)" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="🏁 Gün Sonu Yap" Click="TakeClosureFromReports_Click"
                                                Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="11" Padding="10,5" BorderThickness="0" Cursor="Hand" ToolTip="Günün mali kapanışını yapar ve kasayı kapatır">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </Grid>
                                    
                                    <TextBlock Grid.Row="1" Text="Mali gün sonu kapanışı, net ciro, nakit/kart/veresiye dağılımı ve resmî kapanış kârı." 
                                               FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Grid.Row="2" Text="📅 Tekil Tarih Seçimi" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,8,0,0"/>
                                </Grid>
                            </Border>

                            <!-- 2. X Raporu -->
                            <Border x:Name="CardXReport" Grid.Column="1" MouseLeftButtonDown="SelectReport_Click" Tag="X"
                                    Background="White" CornerRadius="12" Margin="8,0,0,0" Padding="16" 
                                    BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🕒" FontSize="22" Margin="0,0,8,0"/>
                                        <TextBlock Text="X Raporu (Gün Ortası Canlı Kasa)" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Kasa açıkken gün ortası anlık nakit durumu, ara satışlar ve fiziksel bakiye dökümü." 
                                               FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Text="🟢 Anlık Canlı Durum (Mali Hafızayı Sıfırlamaz)" FontSize="11" FontWeight="SemiBold" Foreground="#059669" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- GENEL RAPOR KARTLARI (Satış, Aylık Ciro, Yıllık Ciro, Aylık Ürün, Kâr/Zarar) -->
                        <UniformGrid x:Name="PanelGeneralCards" Grid.Row="1" Columns="5" Margin="0,0,0,12" Visibility="Collapsed">
                            <!-- 3. Satış Raporu -->
                            <Border x:Name="CardSalesReport" MouseLeftButtonDown="SelectReport_Click" Tag="SALES"
                                    Background="White" CornerRadius="12" Margin="0,0,6,0" Padding="14" 
                                    BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📑" FontSize="18" Margin="0,0,6,0"/>
                                        <TextBlock Text="Detaylı Satış" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Tüm fişler, kalemler ve kârlılık dökümü." 
                                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <TextBlock Text="Tarih Aralığı" FontSize="11" FontWeight="SemiBold" Foreground="#8B5CF6" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 4. Aylık Ciro Raporu -->
                            <Border x:Name="CardMonthlySales" MouseLeftButtonDown="SelectReport_Click" Tag="MONTHLY_SALES"
                                    Background="White" CornerRadius="12" Margin="4,0,4,0" Padding="14" 
                                    BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📈" FontSize="18" Margin="0,0,6,0"/>
                                        <TextBlock Text="Aylık Ciro" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Ayın gün gün ciro ve tahsilat tablosu." 
                                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <TextBlock Text="Ay / Yıl Bazlı" FontSize="11" FontWeight="SemiBold" Foreground="#D97706" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 5. Yıllık Ciro Raporu (YENİ!) -->
                            <Border x:Name="CardYearlySales" MouseLeftButtonDown="SelectReport_Click" Tag="YEARLY_SALES"
                                    Background="White" CornerRadius="12" Margin="4,0,4,0" Padding="14" 
                                    BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📆" FontSize="18" Margin="0,0,6,0"/>
                                        <TextBlock Text="Yıllık Ciro" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Yılın 12 ayının ay ay ciro ve büyümesi." 
                                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <TextBlock Text="Yıl Bazlı" FontSize="11" FontWeight="SemiBold" Foreground="#4F46E5" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 6. Aylık Ürün Satış -->
                            <Border x:Name="CardMonthlyProducts" MouseLeftButtonDown="SelectReport_Click" Tag="MONTHLY_PRODUCTS"
                                    Background="White" CornerRadius="12" Margin="4,0,4,0" Padding="14" 
                                    BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📦" FontSize="18" Margin="0,0,6,0"/>
                                        <TextBlock Text="Aylık Ürün Satış" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Satılan ürün adetleri ve kârlılık dökümü." 
                                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <TextBlock Text="Ürün Performansı" FontSize="11" FontWeight="SemiBold" Foreground="#0891B2" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 7. Kâr / Zarar Raporu -->
                            <Border x:Name="CardProfitLoss" MouseLeftButtonDown="SelectReport_Click" Tag="PROFIT_LOSS"
                                    Background="White" CornerRadius="12" Margin="6,0,0,0" Padding="14" 
                                    BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚖️" FontSize="18" Margin="0,0,6,0"/>
                                        <TextBlock Text="Kâr / Zarar" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Net satışlar, STMM, masraflar ve kâr." 
                                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <TextBlock Text="Mali Tablo" FontSize="11" FontWeight="SemiBold" Foreground="#16A34A" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- FİLTRE VE DÖNEM SEÇİMİ (FİLTRELE BUTONLU) -->
                        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="18,12" Margin="0,0,0,12"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Sol Taraf: Filtre Girdileri -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                                    <!-- 1. Tekil Tarih Seçici (Z ve X için) -->
                                    <StackPanel x:Name="PanelFilterDaily" Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Tekil Tarih (Z / X Raporu)" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                            <DatePicker x:Name="SingleDatePicker" Width="150" Height="36" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 2. Tarih Aralığı Seçici (Satış & Kâr-Zarar için) -->
                                    <StackPanel x:Name="PanelFilterRange" Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Başlangıç Tarihi" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                            <DatePicker x:Name="StartDatePicker" Width="135" Height="36" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Bitiş Tarihi" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                            <DatePicker x:Name="EndDatePicker" Width="135" Height="36" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 3. Ay ve Yıl Seçici (Aylık Ciro ve Aylık Ürün için) -->
                                    <StackPanel x:Name="PanelFilterMonth" Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Ay (Aylık Raporlar)" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CmbMonth" Width="130" Height="36" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Yıl" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CmbYear" Width="100" Height="36" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 4. Yıl Seçici (Yıllık Ciro Raporu için) -->
                                    <StackPanel x:Name="PanelFilterYear" Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Rapor Yılı" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CmbYearOnly" Width="120" Height="36" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                </StackPanel>

                                <!-- Sağ Taraf: FİLTRELE BUTONU -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button x:Name="BtnFilterReports" Content="🔍 Filtrele" Click="BtnFilterReports_Click"
                                            Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="13" Padding="20,9" 
                                            BorderThickness="0" Cursor="Hand" ToolTip="Seçilen tarihe ve döneme göre raporu ve grafikleri filtrele">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- AKSİYON ÇUBUĞU (PDF AÇ / KAYDET) -->
                        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,0,12"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSelectedReportTitle" Text="Seçili: Z Raporu (Gün Sonu)" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock x:Name="TxtSelectedReportSubtitle" Text="Tarih: 07.10.2026 | Resmî mali gün sonu kapanışı" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="BtnTakeClosureAction" Content="🏁 Gün Sonu Yap" Click="TakeClosureFromReports_Click" Margin="0,0,10,0"
                                            Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="13" Padding="16,9" BorderThickness="0" Cursor="Hand" ToolTip="Seçili tekil tarih için gün sonu kapanışı alır">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>

                                    <Button Content="🔄 Verileri Yenile" Click="RefreshData_Click" Margin="0,0,10,0"
                                            Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" Padding="14,9" BorderBrush="#CBD5E1" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>

                                    <Button Content="💾 PDF Olarak Kaydet" Click="SavePdf_Click" Margin="0,0,10,0"
                                            Background="#F8FAFC" Foreground="#2563EB" FontWeight="Bold" Padding="16,9" BorderBrush="#BFDBFE" BorderThickness="1.5" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>

                                    <Button Content="📄 PDF Oluştur &amp; Aç" Click="OpenPdf_Click"
                                            Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="14" Padding="20,9" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- SÜTUN GRAFİĞİ VE KPI KARTLARI PANELİ (YENİ!) -->
                        <Border x:Name="ChartSectionBorder" Grid.Row="4" Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,12"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Grafik Başlığı & KPI Kartları -->
                                    <RowDefinition Height="Auto"/> <!-- Sütun Grafiği Çizim Alanı -->
                                </Grid.RowDefinitions>

                                <!-- Üst Satır: Grafik Başlığı ve Toplam / Ortalama Kutucukları -->
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtChartTitle" Text="📊 Rapor Sütun Grafiği &amp; Dağılım Analizi" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                        <TextBlock Text="Gün gün veya ay ay gerçekleşen tutarlar, toplamlar ve ortalamalar" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- KPI Kartları (Toplam, Ortalama, En Yüksek) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- KPI 1: Toplam -->
                                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtKpiTotalLabel" Text="Toplam Ciro" FontSize="10" FontWeight="SemiBold" Foreground="#166534"/>
                                                <TextBlock x:Name="TxtKpiTotalValue" Text="₺0,00" FontSize="14" FontWeight="Bold" Foreground="#15803D"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- KPI 2: Ortalama -->
                                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtKpiAvgLabel" Text="Günlük Ortalama" FontSize="10" FontWeight="SemiBold" Foreground="#1E40AF"/>
                                                <TextBlock x:Name="TxtKpiAvgValue" Text="₺0,00" FontSize="14" FontWeight="Bold" Foreground="#2563EB"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- KPI 3: En Yüksek / Ek Bilgi -->
                                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtKpiExtraLabel" Text="En Yüksek" FontSize="10" FontWeight="SemiBold" Foreground="#92400E"/>
                                                <TextBlock x:Name="TxtKpiExtraValue" Text="-" FontSize="14" FontWeight="Bold" Foreground="#B45309"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Alt Satır: Sütun Grafiği Çizimi (Yatay Kaydırılabilir) -->
                                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15,12" MinHeight="210">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="ChartItemsControl">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Height="190"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="82" Margin="4,0" VerticalAlignment="Bottom">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/> <!-- Değer Yazısı (Tutar) -->
                                                            <RowDefinition Height="Auto"/> <!-- Sütun Çubuğu -->
                                                            <RowDefinition Height="Auto"/> <!-- Taban Çizgisi -->
                                                            <RowDefinition Height="Auto"/> <!-- Ana Etiket (Gün/Ay) -->
                                                            <RowDefinition Height="Auto"/> <!-- Alt Etiket -->
                                                        </Grid.RowDefinitions>

                                                        <!-- Değer Yazısı -->
                                                        <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="4" Padding="4,2" Margin="0,0,0,5" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayValue}" FontSize="10.5" FontWeight="Bold" 
                                                                       Foreground="#0F172A" HorizontalAlignment="Center"
                                                                       TextTrimming="None" ToolTip="{Binding DisplayValue}"/>
                                                        </Border>

                                                        <!-- Sütun Çubuğu (Bar) -->
                                                        <Border Grid.Row="1" Height="{Binding BarHeight}" Width="42" MinHeight="6"
                                                                Background="{Binding BarColor}" CornerRadius="6,6,0,0"
                                                                ToolTip="{Binding Tooltip}" Cursor="Hand" HorizontalAlignment="Center">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
                                                            </Border.Effect>
                                                        </Border>

                                                        <!-- Taban Çizgisi -->
                                                        <Rectangle Grid.Row="2" Height="1.5" Fill="#CBD5E1" Margin="0,2,0,3"/>

                                                        <!-- Ana Etiket (Örn: 01, Oca, Nakit) -->
                                                        <TextBlock Grid.Row="3" Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="#334155" HorizontalAlignment="Center" TextAlignment="Center"
                                                                   TextTrimming="None" ToolTip="{Binding Label}"/>

                                                        <!-- Alt Etiket (Örn: Pzt, #1) -->
                                                        <TextBlock Grid.Row="4" Text="{Binding SubLabel}" FontSize="9.5" Foreground="#64748B"
                                                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ÖNİZLEME PANELİ (TABLO) -->
                        <Border Grid.Row="5" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1" MinHeight="260">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" x:Name="TxtPreviewHeader" Text="📋 Canlı Rapor Önizleme Özeti" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                                <DataGrid Grid.Row="1" x:Name="PreviewDataGrid" AutoGenerateColumns="True"
                                          Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                          RowHeight="36" ColumnHeaderHeight="38" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F1F5F9" HeadersVisibility="Column"
                                          CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                            <Setter Property="Foreground" Value="#475569"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Padding" Value="10,0"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Padding" Value="10,0"/>
                                        </Style>
                                    </DataGrid.Resources>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- SEKME 2: GEÇMİŞ GÜN SONU (Z RAPORU) ARŞİVİ -->
            <TabItem Header="🏁 Geçmiş Gün Sonu (Z Raporu) Kayıtları" FontSize="14" FontWeight="SemiBold" Padding="16,8">
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Başlık & Butonlar -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🏁 Geçmiş Gün Sonu (Z Raporu) Arşivi" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Kaydedilen tüm resmî gün sonlarının arşivi, ciro, tahsilat dağılımı ve kâr kayıtları" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📅 Tarih:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,6,0"/>
                                <DatePicker x:Name="FilterClosureDate" Width="125" SelectedDateChanged="FilterClosureDate_SelectedDateChanged" Margin="0,0,6,0"/>
                                <Button Content="❌ Tümü" Click="ClearClosureFilter_Click"
                                        Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold"
                                        Padding="8,5" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Margin="0,0,6,0">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="🏦 Sadece IBAN" Click="FilterOnlyIban_Click"
                                        Background="#FEF3C7" Foreground="#92400E" FontWeight="SemiBold"
                                        Padding="8,5" BorderBrush="#FCD34D" BorderThickness="1" Cursor="Hand" Margin="0,0,6,0">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="🔄 Yenile" Click="RefreshClosures_Click"
                                        Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                                        Padding="10,5" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Gün Sonu Tablosu -->
                        <DataGrid Grid.Row="1" x:Name="ClosuresGrid" AutoGenerateColumns="False" 
                                  Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                  RowHeight="38" ColumnHeaderHeight="38" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9" HeadersVisibility="Column"
                                  CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="6,0"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="6,0"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tarih" Binding="{Binding FormattedDate}" FontWeight="Bold" Width="95"/>
                                <DataGridTextColumn Header="Toplam Ciro" Binding="{Binding FormattedRevenue}" FontWeight="Bold" Width="105"/>
                                <DataGridTextColumn Header="Nakit Satış" Binding="{Binding FormattedCash}" Foreground="#059669" Width="95"/>
                                <DataGridTextColumn Header="Kredi Satış" Binding="{Binding FormattedCreditCard}" Foreground="#2563EB" Width="95"/>
                                <DataGridTextColumn Header="Z Kredi" Binding="{Binding FormattedZReportCredit}" Width="90"/>
                                <DataGridTextColumn Header="IBAN Kapanış" Binding="{Binding FormattedIbanAmount}" Foreground="#D97706" FontWeight="SemiBold" Width="100"/>
                                <DataGridTextColumn Header="Nakit Gider" Binding="{Binding FormattedCashExpense}" Foreground="#DC2626" Width="90"/>
                                <DataGridTextColumn Header="Kredi Gider" Binding="{Binding FormattedCreditExpense}" Foreground="#DC2626" Width="90"/>
                                <DataGridTextColumn Header="KDV" Binding="{Binding FormattedVatAmount}" Width="75"/>
                                <DataGridTextColumn Header="Cep Nakit" Binding="{Binding FormattedPocketCash}" Width="90"/>
                                <DataGridTextColumn Header="Net Kâr" Binding="{Binding FormattedProfit}" FontWeight="Bold" Width="100"/>
                                <DataGridTextColumn Header="Kaynak &amp; Not" Binding="{Binding Notes}" Width="*"/>
                                
                                <DataGridTemplateColumn Header="İşlemler" Width="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="⚡ Z Raporu" Click="OpenRowZReport_Click"
                                                        Padding="6,3" Background="#EFF6FF" Foreground="#2563EB" FontWeight="SemiBold"
                                                        BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                </Button>
                                                <Button Content="🧾 Fişler" Click="OpenRowReceiptBreakdown_Click"
                                                        Padding="6,3" Background="#F0FDF4" Foreground="#16A34A" FontWeight="SemiBold"
                                                        BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                </Button>
                                                <Button Content="✏️ Not" Click="EditClosureNotes_Click"
                                                        Padding="6,3" Background="#FEF3C7" Foreground="#B45309" FontWeight="SemiBold"
                                                        BorderThickness="0" Cursor="Hand" Margin="0,0,4,0" ToolTip="Kapanış notunu düzenle">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                </Button>
                                                <Button Content="🗑️ Sil" Click="DeleteClosure_Click"
                                                        Padding="6,3" Background="#FEF2F2" Foreground="#DC2626" FontWeight="SemiBold"
                                                        BorderThickness="0" Cursor="Hand" ToolTip="Bu gün sonu kaydını sil">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Page>