<Window x:Class="ERP.Desktop.Views.DbConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQL Server Veritabanı Bağlantı Ayarı"
        Width="520" Height="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#334155" BorderThickness="1.5"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Başlık -->
                <RowDefinition Height="Auto"/> <!-- Açıklama & Durum -->
                <RowDefinition Height="*"/>    <!-- Ayarlar & Şablonlar -->
                <RowDefinition Height="Auto"/> <!-- Butonlar -->
            </Grid.RowDefinitions>

            <!-- 1. Başlık & Kapat Butonu -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#1E293B" Margin="0,0,12,0">
                        <TextBlock Text="🗄️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SQL Server Veritabanı Ayarı" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Uygulamanın bağlanacağı SQL Server örneğini yapılandırın" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <Button Content="✕" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                        FontSize="16" FontWeight="Bold" Cursor="Hand" Width="28" Height="28"/>
            </Grid>

            <!-- 2. Canlı Bağlantı Durumu Kartı -->
            <Border Grid.Row="1" x:Name="BorderStatus" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="DotStatus" Width="10" Height="10" Fill="#EAB308" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatusTitle" Text="Bağlantı Durumu:" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1"/>
                        <TextBlock x:Name="TxtStatusDetail" Text="Kontrol ediliyor..." FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Form Alanı -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="SQL Server Bağlantı Dizesi (Connection String):" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="8" Padding="6,4" Margin="0,0,0,10">
                    <TextBox x:Name="TxtConnStr" 
                             Background="Transparent" Foreground="White" BorderThickness="0"
                             FontSize="12" Height="50" TextWrapping="Wrap" AcceptsReturn="False"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center"/>
                </Border>

                <!-- Hızlı Şablon Butonları -->
                <TextBlock Text="Hızlı Şablonlar:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <Button Content="⚡ .\SQLEXPRESS (Yerel Express)" Click="UseSqlExpress_Click" Margin="0,0,4,0" Padding="8,6"
                            Background="#1E293B" Foreground="#93C5FD" BorderBrush="#334155" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button Content="💻 localhost (Varsayılan Yerel)" Click="UseLocalhost_Click" Margin="4,0,0,0" Padding="8,6"
                            Background="#1E293B" Foreground="#93C5FD" BorderBrush="#334155" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </UniformGrid>

                <!-- Araç Butonları (Test & Algıla) -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="🔌 Bağlantıyı Test Et" Click="TestConnection_Click" Margin="0,0,4,0" Padding="10,8"
                            Background="#1E293B" Foreground="#60A5FA" BorderBrush="#2563EB" BorderThickness="1" FontWeight="Bold" FontSize="11.5" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                    <Button Grid.Column="1" Content="🔍 Yerel SQL'i Otomatik Algıla" Click="AutoDetect_Click" Margin="4,0,0,0" Padding="10,8"
                            Background="#064E3B" Foreground="#34D399" BorderBrush="#059669" BorderThickness="1" FontWeight="Bold" FontSize="11.5" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- 4. Alt Butonlar -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Button Content="İptal" Click="Close_Click" HorizontalAlignment="Left"
                        Background="#1E293B" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="12.5"
                        Padding="18,9" BorderBrush="#334155" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>

                <Button Content="💾 Kaydet &amp; Uygula" Click="SaveAndApply_Click" HorizontalAlignment="Right"
                        Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="12.5"
                        Padding="20,9" BorderThickness="0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
