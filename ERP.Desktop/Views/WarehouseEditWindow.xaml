<Window x:Class="ERP.Desktop.Views.WarehouseEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Depo Tanımı" Height="460" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock x:Name="TxtTitle" Text="🏬 Yeni Depo Oluştur" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Stoklarınızı takip etmek için yeni bir depo tanımlayın" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Form Alanları -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="Depo Kodu" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtCode" Height="40" FontSize="14" Padding="10,0" VerticalContentAlignment="Center"
                         BorderBrush="#CBD5E1" Margin="0,0,0,16"/>

                <TextBlock Text="Depo Adı *" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtName" Height="40" FontSize="14" Padding="10,0" VerticalContentAlignment="Center"
                         BorderBrush="#CBD5E1" Margin="0,0,0,16"/>

                <TextBlock Text="Konum / Adres / Raf" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtLocation" Height="40" FontSize="14" Padding="10,0" VerticalContentAlignment="Center"
                         BorderBrush="#CBD5E1" Margin="0,0,0,16"/>

                <TextBlock Text="Açıklama" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtDescription" Height="50" FontSize="14" Padding="10,8" VerticalContentAlignment="Top"
                         TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="#CBD5E1" Margin="0,0,0,16"/>

                <CheckBox x:Name="ChkIsDefault" Content="⭐ Bu depoyu varsayılan ana depo yap" FontSize="13" FontWeight="SemiBold"
                          Foreground="#0F172A" Margin="0,0,0,10"/>
            </StackPanel>

            <!-- Butonlar -->
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="İptal" Click="Cancel_Click" Margin="0,0,8,0" Height="42"
                        Background="#F1F5F9" Foreground="#475569" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Grid.Column="1" Content="💾 Kaydet" Click="Save_Click" Margin="8,0,0,0" Height="42"
                        Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
