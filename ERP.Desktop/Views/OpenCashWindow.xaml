<Window x:Class="ERP.Desktop.Views.OpenCashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gün Açılışı &amp; Kasa Açılışı" Height="440" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8FAFC" ShowInTaskbar="False">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK -->
        <Border Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🌅" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Gün Açılışı &amp; Kasa Açılışı" FontSize="22" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Güne başlarken kasadaki devreden nakit tutarını onaylayarak gün açılışı yapın. Kasa açılışı sisteme artı para sokmaz, devreden nakiti belirler." 
                           FontSize="13" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- FORM ALANI -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <!-- Bilgilendirme Kutusu -->
                <Border Background="#EFF6FF" CornerRadius="8" Padding="12,10" Margin="0,0,0,16" BorderBrush="#BFDBFE" BorderThickness="1">
                    <TextBlock Text="ℹ️ Kasa açılışı yapıldığında sistemde yeni gün aktif hale gelir ve satış terminali kullanıma açılır." 
                               FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap"/>
                </Border>

                <!-- Başlangıç Nakiti Label -->
                <TextBlock Text="Güne Başlangıç / Devir Nakiti (₺) *" FontSize="14" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>

                <!-- Giriş Kutusu -->
                <TextBox x:Name="TxtOpeningCash" Height="48" FontSize="22" FontWeight="Bold" Padding="12,6"
                         VerticalContentAlignment="Center" Text="0,00" BorderBrush="#2563EB" BorderThickness="2"/>

                <!-- Hızlı Tutar Ekleme Butonları -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,16">
                    <Button Content="+100 ₺" Click="PresetCash_Click" Tag="100" Margin="0,0,6,0" Padding="10,6" Background="#F1F5F9" FontWeight="SemiBold" BorderBrush="#CBD5E1" Cursor="Hand"/>
                    <Button Content="+250 ₺" Click="PresetCash_Click" Tag="250" Margin="0,0,6,0" Padding="10,6" Background="#F1F5F9" FontWeight="SemiBold" BorderBrush="#CBD5E1" Cursor="Hand"/>
                    <Button Content="+500 ₺" Click="PresetCash_Click" Tag="500" Margin="0,0,6,0" Padding="10,6" Background="#F1F5F9" FontWeight="SemiBold" BorderBrush="#CBD5E1" Cursor="Hand"/>
                    <Button Content="+1.000 ₺" Click="PresetCash_Click" Tag="1000" Margin="0,0,6,0" Padding="10,6" Background="#F1F5F9" FontWeight="SemiBold" BorderBrush="#CBD5E1" Cursor="Hand"/>
                    <Button Content="Sıfırla" Click="ResetCash_Click" Padding="10,6" Background="#FEE2E2" Foreground="#DC2626" FontWeight="SemiBold" BorderBrush="#FECACA" Cursor="Hand"/>
                </StackPanel>

                <!-- Açılış Notu -->
                <TextBlock Text="Açılış Notu (Opsiyonel)" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtNotes" Height="36" Padding="8,4" FontSize="13" VerticalContentAlignment="Center"
                         Text="Günün İlk Açılışı"/>
            </StackPanel>
        </Border>

        <!-- BUTONLAR -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Vazgeç" Click="Cancel_Click" Margin="0,0,10,0" Padding="20,10"
                    Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" BorderBrush="#CBD5E1" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                </Button.Resources>
            </Button>

            <Button Grid.Column="2" Content="🟢 Gün Açılışını Onayla &amp; Başla" Click="Confirm_Click" Padding="24,10"
                    Background="#059669" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
