<Window x:Class="ERP.Desktop.Views.InvoiceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni Fatura Girişi" Height="740" Width="980"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Başlık -->
                <RowDefinition Height="Auto"/> <!-- Fatura Üst Bilgileri -->
                <RowDefinition Height="Auto"/> <!-- Kalem Ekleme Çubuğu -->
                <RowDefinition Height="*"/>    <!-- Fatura Kalemleri Tablosu -->
                <RowDefinition Height="Auto"/> <!-- Alt Toplamlar ve Kaydet Butonu -->
            </Grid.RowDefinitions>

            <!-- 1. BAŞLIK -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,12"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TxtModalTitle" Text="📥 Yeni Alış Faturası Girişi" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Fatura bilgilerini girin; kaydedildiğinde fatura kalemleri seçilen depoya otomatik stok olarak eklenecektir."
                                   FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="8" Padding="12,6" BorderBrush="#A7F3D0" BorderThickness="1">
                        <TextBlock Text="📦 Otomatik Depo Girişi" FontWeight="Bold" Foreground="#059669" FontSize="12"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. FATURA ÜST BİLGİLERİ -->
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16,14" Margin="0,0,0,12"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <!-- Satır 1 -->
                    <!-- Fatura Türü -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock Text="Fatura Türü *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbInvoiceType" Height="36" SelectionChanged="CmbInvoiceType_SelectionChanged" BorderBrush="#CBD5E1">
                            <ComboBoxItem Content="Alış Faturası" IsSelected="True"/>
                            <ComboBoxItem Content="Satış Faturası"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Fatura No -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,10">
                        <TextBlock Text="Fatura No *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtInvoiceNo" Height="36" FontWeight="Bold" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- Tedarikçi / Cari Firma -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,10">
                        <TextBlock Text="Tedarikçi / Cari Firma *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbCariAccount" Height="36" IsEditable="True" DisplayMemberPath="DisplayText" BorderBrush="#CBD5E1" SelectionChanged="CmbCariAccount_SelectionChanged"
                                  ToolTip="Listeden cari seçin veya yeni firma ünvanı yazın."/>
                    </StackPanel>

                    <!-- Tarih -->
                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,10,10">
                        <TextBlock Text="Fatura Tarihi *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpInvoiceDate" Height="36" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- Giriş / İlgili Depo (ÇOK ÖNEMLİ) -->
                    <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,10">
                        <TextBlock Text="🏬 Giriş Yapılacak Depo *" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbTargetWarehouse" Height="36" DisplayMemberPath="DisplayText" BorderBrush="#2563EB" BorderThickness="1.5"/>
                    </StackPanel>

                    <!-- Satır 2: Ödeme Durumu, Kanal ve Hesap Seçimi -->
                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/> <!-- Ödeme Durumu -->
                            <ColumnDefinition Width="150"/> <!-- Ödeme Kanalı (Nakit / Banka) -->
                            <ColumnDefinition Width="260"/> <!-- Banka / Kasa / Cari Seçimi -->
                            <ColumnDefinition Width="130"/> <!-- Vergi No -->
                            <ColumnDefinition Width="*"/>   <!-- Not -->
                        </Grid.ColumnDefinitions>

                        <!-- 1. Ödeme Durumu -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Ödeme Durumu *" FontSize="12" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbPaymentStatus" Height="36" BorderBrush="#CBD5E1" SelectionChanged="CmbPaymentStatus_SelectionChanged">
                                <ComboBoxItem Content="Ödendi" IsSelected="True"/>
                                <ComboBoxItem Content="Ödenmedi"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- 2. Ödeme Kanalı (Ödendiğinde Nakit veya Banka Hesabı) -->
                        <StackPanel x:Name="PnlPaymentChannel" Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Ödeme Şekli *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbPaymentChannel" Height="36" BorderBrush="#CBD5E1" SelectionChanged="CmbPaymentChannel_SelectionChanged">
                                <ComboBoxItem Content="Nakit" IsSelected="True"/>
                                <ComboBoxItem Content="Banka Hesabı"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- 3. Hesap Seçici / Cari Bilgi Alanı -->
                        <Grid Grid.Column="2" Margin="0,0,10,0">
                            <!-- Durum A: Banka Hesabı Seçimi -->
                            <StackPanel x:Name="PnlBankAccount" Visibility="Collapsed">
                                <TextBlock Text="Banka Hesabı *" FontSize="12" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbBankAccount" Height="36" BorderBrush="#0284C7" BorderThickness="1.5" DisplayMemberPath="DisplayText"/>
                            </StackPanel>

                            <!-- Durum B: Nakit Kasa Bilgisi -->
                            <StackPanel x:Name="PnlCashInfo" Visibility="Visible">
                                <TextBlock Text="Kasa Noktası" FontSize="12" FontWeight="SemiBold" Foreground="#059669" Margin="0,0,0,4"/>
                                <Border Height="36" Background="#ECFDF5" CornerRadius="6" BorderBrush="#A7F3D0" BorderThickness="1" Padding="8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="💵 Merkez Nakit Kasa" FontWeight="SemiBold" Foreground="#065F46" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Durum C: Cari (Açık Hesap / Vadeli) -->
                            <StackPanel x:Name="PnlCurrentAccount" Visibility="Collapsed">
                                <TextBlock Text="Cari Bakiye Durumu" FontSize="12" FontWeight="Bold" Foreground="#EA580C" Margin="0,0,0,4"/>
                                <Border Height="36" Background="#FFF7ED" CornerRadius="6" BorderBrush="#FDBA74" BorderThickness="1" Padding="8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtCariStatusSummary" Text="📋 Açık Hesap (Cariye İşlenecek)" FontWeight="SemiBold" Foreground="#C2410C" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 4. Vergi No / T.C. -->
                        <StackPanel Grid.Column="3" Margin="0,0,10,0">
                            <TextBlock Text="Vergi No / T.C." FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtTaxNo" Height="36" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                        </StackPanel>

                        <!-- 5. Fatura Notu -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Fatura Notu / Açıklama" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtNotes" Height="36" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. KALEM EKLEME ÇUBUĞU -->
            <Border Grid.Row="2" Background="#EFF6FF" CornerRadius="10" Padding="16,12" Margin="0,0,0,12"
                    BorderBrush="#BFDBFE" BorderThickness="1.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ürün Seçimi -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Eklenecek Ürün *" FontSize="12" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbProductPicker" Height="38" DisplayMemberPath="DisplayInfo"
                                  SelectionChanged="CmbProductPicker_SelectionChanged" BorderBrush="#93C5FD"/>
                    </StackPanel>

                    <!-- Miktar -->
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Miktar (Adet) *" FontSize="12" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtItemQuantity" Height="38" Text="1" FontWeight="Bold" FontSize="14"
                                 Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#93C5FD"/>
                    </StackPanel>

                    <!-- Alış Birim Fiyatı -->
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock x:Name="LblUnitPrice" Text="Birim Alış (₺) *" FontSize="12" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtItemUnitPrice" Height="38" Text="0,00" FontWeight="Bold" FontSize="14"
                                 Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#93C5FD"/>
                    </StackPanel>

                    <!-- KDV Oranı -->
                    <StackPanel Grid.Column="3" Margin="0,0,12,0">
                        <TextBlock Text="KDV (%)" FontSize="12" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbItemVatRate" Height="38" BorderBrush="#93C5FD">
                            <ComboBoxItem Content="%20" Tag="20" IsSelected="True"/>
                            <ComboBoxItem Content="%10" Tag="10"/>
                            <ComboBoxItem Content="%1" Tag="1"/>
                            <ComboBoxItem Content="%0" Tag="0"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Kalemi Ekle Butonu -->
                    <Button Grid.Column="4" Content="➕ Kalemi Ekle" Click="AddItem_Click" VerticalAlignment="Bottom" Height="38"
                            Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="13" Padding="18,0"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- 4. FATURA KALEMLERİ TABLOSU -->
            <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="10" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,12">
                <DataGrid x:Name="InvoiceItemsGrid" AutoGenerateColumns="False" Background="White"
                          BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="38" ColumnHeaderHeight="36"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kod" Binding="{Binding ProductCode}" Width="100"/>
                        <DataGridTextColumn Header="Barkod" Binding="{Binding Barcode}" Width="110"/>
                        <DataGridTextColumn Header="Ürün Adı" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity, StringFormat='{}{0:N0} Adet'}" Width="90"/>
                        <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding FormattedUnitPrice}" Width="100"/>
                        <DataGridTextColumn Header="KDV %" Binding="{Binding VatRate, StringFormat='%{0:N0}'}" Width="65"/>
                        <DataGridTextColumn Header="KDV Tutarı" Binding="{Binding VatAmount, StringFormat='₺{0:N2}'}" Width="95"/>
                        <DataGridTextColumn Header="Genel Tutar" Binding="{Binding FormattedGrandTotal}" Width="110"/>

                        <!-- Kalem Sil Butonu -->
                        <DataGridTemplateColumn Header="İşlem" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕ Sil" Click="RemoveItem_Click" Background="Transparent"
                                            Foreground="#DC2626" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 5. ALT TOPLAMLAR VE KAYDET BUTONU -->
            <Border Grid.Row="4" Background="White" CornerRadius="10" Padding="16,14" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtItemsSummary" Text="0 Kalem / 0 Adet Ürün Eklendi" FontSize="14" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBlock Text="Fatura kaydedildiğinde stoklar anında seçilen depoya aktarılacaktır." FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Ara Toplam (KDV Hariç):" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtSubTotal" Text="₺0,00" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#1E293B"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Toplam KDV:" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtVatTotal" Text="₺0,00" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#1E293B"/>
                        </Grid>
                        <Separator Margin="0,2,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="GENEL TOPLAM:" FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtGrandTotal" Text="₺0,00" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#2563EB"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="İptal" Click="Cancel_Click" Margin="0,0,6,0" Height="42"
                                    Background="#F1F5F9" Foreground="#475569" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Grid.Column="1" Content="💾 Faturayı Kaydet" Click="SaveInvoice_Click" Margin="6,0,0,0" Height="42"
                                    Background="#059669" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
