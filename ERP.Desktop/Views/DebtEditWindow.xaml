<Window x:Class="ERP.Desktop.Views.DebtEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Borç &amp; Kredi Tanımı" Height="680" Width="520" MinHeight="580" MinWidth="460"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TxtHeading" Text="💳 Finansal Borç / Kredi Tanımla" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Kredi kartı, KMH/ek hesap, banka kredisi veya cari borç kaydı oluşturun. Taksit ve faiz motoruyla entegre çalışır." 
                       FontSize="12" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel Margin="0,0,0,8">
                <!-- Borç Türü ve Bağlı Banka -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Borç Türü *" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbDebtType" Height="36" FontSize="12" SelectedIndex="0">
                            <ComboBoxItem Content="Taksitli Kredi"/>
                            <ComboBoxItem Content="Kredi Kartı"/>
                            <ComboBoxItem Content="KMH / Ek Hesap"/>
                            <ComboBoxItem Content="Şahıs / Senet Borcu"/>
                            <ComboBoxItem Content="Diğer"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Bağlı Banka / Kart Hesabı" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbBankAccount" Height="36" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <!-- Borç Adı -->
                <TextBlock Text="Borç / Kredi Adı *" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtTitle" Height="36" Padding="8,6" Background="White" BorderBrush="#CBD5E1" ToolTip="Örn: Garanti BBVA Ticari Kredi, Şahsi Borç"/>

                <!-- Alacaklı / Kurum -->
                <TextBlock Text="Alacaklı / Kurum / Kişi *" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,10,0,4"/>
                <TextBox x:Name="TxtCreditor" Height="36" Padding="8,6" Background="White" BorderBrush="#CBD5E1" ToolTip="Örn: Banka Adı, Tedarikçi veya Şahıs Adı"/>

                <!-- Toplam Borç ve Aylık Taksit (Yan Yana) -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Toplam Borç Tutarı (₺) *" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtTotalAmount" Height="38" Padding="10,6" FontSize="15" FontWeight="Bold" Foreground="#0284C7" Background="White" BorderBrush="#CBD5E1" TextChanged="TotalOrInstallment_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Aylık Taksit Tutarı (₺) *" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtInstallmentAmount" Height="38" Padding="10,6" FontSize="15" FontWeight="Bold" Foreground="#059669" Background="White" BorderBrush="#CBD5E1" TextChanged="TotalOrInstallment_TextChanged"/>
                    </StackPanel>
                </Grid>

                <!-- Kalan Borç ve Kalan Taksit (Yan Yana) -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Kalan Anapara Tutarı (₺) *" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtRemainingAmount" Height="38" Padding="10,6" FontSize="15" FontWeight="Bold" Foreground="#DC2626" Background="White" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Kalan Taksit Sayısı" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtRemainingInstallments" Text="1" Height="38" Padding="10,6" FontSize="15" FontWeight="Bold" HorizontalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1"/>
                    </StackPanel>
                </Grid>

                <!-- Faiz Oranı ve Asgari Ödeme -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Aylık Faiz Oranı (%)" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtInterestRate" Text="4,25" Height="36" Padding="10,6" FontSize="14" FontWeight="Bold" Foreground="#D97706" Background="White" BorderBrush="#CBD5E1" ToolTip="Akdi Aylık Faiz Oranı"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Asgari Ödeme Tutarı (₺)" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtMinPayment" Text="0,00" Height="36" Padding="10,6" FontSize="14" FontWeight="Bold" Background="White" BorderBrush="#CBD5E1"/>
                    </StackPanel>
                </Grid>

                <!-- Ödeme Günü ve Başlangıç Tarihi -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Her Ayın Günü *" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtDayOfMonth" Text="15" Height="36" Padding="10,6" FontSize="14" FontWeight="Bold" HorizontalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" ToolTip="1 ile 31 arasında gün"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Başlangıç Tarihi" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpStartDate" Height="36" Background="White"/>
                    </StackPanel>
                </Grid>

                <!-- Açıklama -->
                <TextBlock Text="Açıklama / Not" FontWeight="SemiBold" Foreground="#334155" FontSize="12" Margin="0,12,0,4"/>
                <TextBox x:Name="TxtNotes" Height="46" Padding="8,6" Background="White" BorderBrush="#CBD5E1" TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Butonlar -->
        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="İptal" Width="90" Height="38" Background="#E2E8F0" Foreground="#475569" FontWeight="SemiBold" 
                        Margin="0,0,10,0" Click="Cancel_Click" BorderThickness="0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
                <Button Content="💾 Borcu Kaydet" Width="140" Height="38" Background="#2563EB" Foreground="White" 
                        FontWeight="Bold" Click="Save_Click" BorderThickness="0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
