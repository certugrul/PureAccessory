<Page x:Class="ERP.Desktop.Views.InvoicesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F8FAFC">

    <Grid Margin="15,10,15,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Başlık -->
            <RowDefinition Height="Auto"/> <!-- İstatistik Kartları -->
            <RowDefinition Height="Auto"/> <!-- Filtre Çubuğu -->
            <RowDefinition Height="*"/>    <!-- Fatura Tablosu -->
        </Grid.RowDefinitions>

        <!-- 1. ÜST PANEL -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,15"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📄 Faturalar ve Mal Kabul Yönetimi" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Alış faturaları kaydedin; fatura kalemleri seçilen depoya otomatik eklenir ve maliyetler güncellenir"
                               FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="➕ Yeni Alış Faturası Ekle" Click="CreateInvoice_Click"
                            Background="#059669" Foreground="White" FontWeight="Bold" FontSize="14"
                            Padding="20,10" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. İSTATİSTİK KARTLARI -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Kart 1: Toplam Fatura -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,10,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TOPLAM FATURA ADEDİ" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtTotalInvoices" Text="0" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Kart 2: Toplam Alış Faturaları Tutarı -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,10,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TOPLAM ALIŞ FATURALARI" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtTotalPurchases" Text="₺0,00" FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Kart 3: Toplam Satış Faturaları -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,10,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TOPLAM SATIŞ FATURALARI" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtTotalSalesInvoices" Text="₺0,00" FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Kart 4: Depoya Giriş Yapılan Ürün Adedi -->
            <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="18,14"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="GİRİŞ YAPILAN TOPLAM ADET" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtTotalItemsReceived" Text="0 Adet" FontSize="24" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. FİLTRELER -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,15"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tür:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbTypeFilter" Width="140" Height="36" SelectionChanged="Filter_Changed" BorderBrush="#CBD5E1" Margin="0,0,15,0">
                        <ComboBoxItem Content="Tümü" IsSelected="True"/>
                        <ComboBoxItem Content="Alış Faturası"/>
                        <ComboBoxItem Content="Satış Faturası"/>
                    </ComboBox>

                    <TextBlock Text="Arama:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtSearch" Width="200" Height="36" Padding="8,0" VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged" BorderBrush="#CBD5E1" ToolTip="Fatura no veya cari adı ara..." Margin="0,0,15,0"/>

                    <TextBlock Text="Tarih:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DpStart" Width="130" Height="36" VerticalContentAlignment="Center" SelectedDateChanged="Filter_Changed" Margin="0,0,6,0"/>
                    <TextBlock Text="-" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DpEnd" Width="130" Height="36" VerticalContentAlignment="Center" SelectedDateChanged="Filter_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🔄 Yenile" Click="Refresh_Click"
                            Background="#F1F5F9" Foreground="#334155" FontWeight="Bold" Padding="16,8"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. FATURA TABLOSU -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid x:Name="InvoicesGrid" AutoGenerateColumns="False" Background="White"
                      BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="42" ColumnHeaderHeight="38"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                      HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fatura No" Binding="{Binding InvoiceNo}" Width="130"/>
                    <DataGridTextColumn Header="Tür" Binding="{Binding Type}" Width="120"/>
                    <DataGridTextColumn Header="Tarih" Binding="{Binding FormattedDate}" Width="100"/>
                    <DataGridTextColumn Header="Tedarikçi / Cari Ünvanı" Binding="{Binding SupplierOrCustomer}" Width="*"/>
                    <DataGridTextColumn Header="Giriş Deposu" Binding="{Binding WarehouseName}" Width="130"/>
                    <DataGridTextColumn Header="Kalem / Adet" Binding="{Binding SummaryText}" Width="140"/>
                    <DataGridTextColumn Header="Genel Toplam" Binding="{Binding FormattedGrandTotal}" Width="120"/>
                    <DataGridTextColumn Header="Ödeme Durumu" Binding="{Binding PaymentSummaryText}" Width="170"/>

                    <DataGridTemplateColumn Header="İşlemler" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="🔍 Detay" Click="ViewDetails_Click" Padding="6,2" Margin="0,0,6,0"
                                            Background="#EFF6FF" Foreground="#2563EB" FontWeight="SemiBold"
                                            BorderThickness="0" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="🗑️ Sil" Click="DeleteInvoice_Click" Padding="6,2"
                                            Background="#FEF2F2" Foreground="#DC2626" FontWeight="SemiBold"
                                            BorderThickness="0" Cursor="Hand" ToolTip="Faturayı sil, stok ve ödemeleri geri al">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
