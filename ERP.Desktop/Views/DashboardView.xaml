<Page x:Class="ERP.Desktop.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F8FAFC">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10,5,10,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Üst Başlık & Saat/Tarih Paneli -->
                <RowDefinition Height="Auto"/> <!-- Metrik Kartları -->
                <RowDefinition Height="*"/>    <!-- Finansal Takvim & Bildirim Paneli -->
            </Grid.RowDefinitions>

            <!-- ÜST PANEL: BAŞLIK, CANLI SAAT/TARİH & GÜN SONU BUTONU -->
            <Border Grid.Row="0" Background="White" CornerRadius="14" Padding="20,16" Margin="0,0,0,20" 
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sol: Sayfa Başlığı -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Dashboard &amp; Yönetim Paneli" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Canlı işletme durumu, anlık zaman takibi ve gün sonu işlemleri" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Sağ: Canlı Saat & Tarih Rozeti ve Yenile Butonu -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Canlı Dijital Saat & Tarih Kartı -->
                        <Border Background="#F1F5F9" CornerRadius="10" Padding="16,8" Margin="0,0,10,0" BorderBrush="#CBD5E1" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="LiveTimeText" Text="12:00:00" FontSize="22" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="LiveDateText" Text="01.01.2026 Çarşamba" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <!-- Yenile Butonu -->
                        <Button Content="🔄 Yenile" Click="RefreshDashboard_Click"
                                Background="#FFFFFF" Foreground="#334155" FontWeight="Bold" FontSize="13"
                                Padding="14,9" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand" ToolTip="Dashboard verilerini yenile">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- METRİK KARTLARI -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
                <!-- Bugünkü Ciro -->
                <Border Background="White" CornerRadius="12" Margin="0,0,10,0" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Bugünkü Ciro" Foreground="#64748B" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CardRevenueText" Text="₺0,00" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0"/>
                        <TextBlock x:Name="CardRevenueSubText" Text="Tamamlanan satışlar" FontSize="11" Foreground="#10B981" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Bugünkü Kâr -->
                <Border Background="White" CornerRadius="12" Margin="5,0,5,0" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Bugünkü Net Kâr" Foreground="#64748B" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CardProfitText" Text="₺0,00" FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,6,0,0"/>
                        <TextBlock Text="Maliyet ve gider düşüldü" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Bugünkü Kredi Kartı Tutarı -->
                <Border Background="White" CornerRadius="12" Margin="5,0,5,0" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Bugünkü Kredi Kartı Tutarı" Foreground="#64748B" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CardStockText" Text="₺0,00" FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0,6,0,0"/>
                        <TextBlock x:Name="CardStockSubText" Text="Bugün POS ile yapılan tahsilatlar" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Kasa / Nakit -->
                <Border Background="White" CornerRadius="12" Margin="10,0,0,0" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Kasadaki Nakit" Foreground="#64748B" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CardCashText" Text="₺0,00" FontSize="24" FontWeight="Bold" Foreground="#3B82F6" Margin="0,6,0,0"/>
                        <TextBlock x:Name="CardCashSubText" Text="Anlık nakit bakiye" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ROW 2: FİNANSAL TAKVİM VE BİLDİRİM / MASRAF PANELİ (YENİ) -->
            <Border Grid.Row="2" Background="White" CornerRadius="14" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1" MinHeight="520">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Başlık ve Hızlı Aksiyonlar -->
                        <RowDefinition Height="*"/>    <!-- Takvim (Sol) ve Detaylar (Sağ) -->
                        <RowDefinition Height="Auto"/> <!-- Aylık Özet Şeridi -->
                    </Grid.RowDefinitions>

                    <!-- Başlık & Aksiyon Butonları -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📅 Finansal Takvim &amp; Ödeme Bildirimleri" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                                <Border Background="#FEF3C7" CornerRadius="6" Padding="8,3" Margin="10,0,0,0">
                                    <TextBlock x:Name="TxtPendingBadge" Text="0 Bekleyen Ödeme" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Kira, kredi kartı, fatura ve sabit masraflar takvimi. 'Ödendi' seçildiğinde otomatik masraf faturası işlenir." 
                                       FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Butonlar -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="💳 Borç &amp; Finans" Click="OpenDebts_Click"
                                    Background="#059669" Foreground="White" FontWeight="Bold" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Kredi kartları, KMH, krediler ve faiz motoru">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="➕ Yeni Bildirim Ekle" Click="AddReminder_Click"
                                    Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="⚙️ Şablonları &amp; Borçları Yönet" Click="ManageTemplates_Click"
                                    Background="#F8FAFC" Foreground="#2563EB" FontWeight="Bold" Padding="12,8" Margin="0,0,8,0" BorderBrush="#BFDBFE" BorderThickness="1.5" Cursor="Hand"
                                    ToolTip="Düzenli genel gider şablonlarını ve vadeli borçları özelleştirin / yönetin">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="🔄 Yenile" Click="RefreshCalendar_Click"
                                    Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" Padding="10,8" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Ana Bölüm: Sol (Takvim) ve Sağ (Detay Listesi) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420"/> <!-- Takvim -->
                            <ColumnDefinition Width="20"/>  <!-- Ayırıcı Boşluk -->
                            <ColumnDefinition Width="*"/>   <!-- Detaylar -->
                        </Grid.ColumnDefinitions>

                        <!-- SOL KOLON: GÖRSEL TAKVİM -->
                        <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="12" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Ay Gezintisi (Önceki - Ay/Yıl - Sonraki) -->
                                    <RowDefinition Height="Auto"/> <!-- Gün Başlıkları (Pzt ... Paz) -->
                                    <RowDefinition Height="*"/>    <!-- Gün Matrisi -->
                                </Grid.RowDefinitions>

                                <!-- Ay Seçimi -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="◀" Click="PrevMonth_Click" Width="32" Height="32" 
                                            Background="White" BorderBrush="#CBD5E1" FontWeight="Bold" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>

                                    <TextBlock Grid.Column="1" x:Name="TxtMonthYearHeader" Text="Ekim 2026" 
                                               FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <Button Grid.Column="2" Content="▶" Click="NextMonth_Click" Width="32" Height="32" Margin="0,0,6,0"
                                            Background="White" BorderBrush="#CBD5E1" FontWeight="Bold" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>

                                    <Button Grid.Column="3" Content="Bugün" Click="Today_Click" Height="32" Padding="8,0"
                                            Background="#EFF6FF" Foreground="#2563EB" FontWeight="SemiBold" BorderBrush="#BFDBFE" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </Grid>

                                <!-- Haftanın Günleri -->
                                <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,8">
                                    <TextBlock Text="Pzt" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="Sal" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="Çar" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="Per" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="Cum" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="Cmt" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>
                                    <TextBlock Text="Paz" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                                </UniformGrid>

                                <!-- Gün Kutucukları (Dinamik Takvim Matrisi) -->
                                <ItemsControl Grid.Row="2" x:Name="CalendarDaysItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="DayCell_Click" Margin="2" Padding="2" MinHeight="52" 
                                                    Background="{Binding BackgroundBrush}" 
                                                    BorderBrush="{Binding BorderBrush}" 
                                                    BorderThickness="{Binding BorderThickness}" 
                                                    Cursor="Hand" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Gün Numarası -->
                                                    <TextBlock Grid.Row="0" Text="{Binding DayNumber}" 
                                                               FontSize="12" FontWeight="{Binding DayFontWeight}" 
                                                               Foreground="{Binding DayForegroundBrush}" 
                                                               HorizontalAlignment="Left" Margin="3,1,0,0"/>

                                                    <!-- Bildirim Rozeti (Varsa) -->
                                                    <Border Grid.Row="1" Visibility="{Binding BadgeVisibility}" 
                                                            Background="{Binding BadgeBackgroundBrush}" 
                                                            CornerRadius="4" Padding="3,1" Margin="1,2,1,1" VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding BadgeText}" 
                                                                   FontSize="9" FontWeight="Bold" 
                                                                   Foreground="{Binding BadgeForegroundBrush}" 
                                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- SAĞ KOLON: SEÇİLİ GÜNÜN DETAYI VE ÖDEME LİSTESİ -->
                        <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Seçili Gün Başlığı & Filtre -->
                                    <RowDefinition Height="*"/>    <!-- Liste -->
                                </Grid.RowDefinitions>

                                <!-- Başlık ve Gösterim Modu -->
                                <Border Grid.Row="0" Background="#F8FAFC" Margin="-14,-14,-14,12" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="TxtSelectedDayTitle" Text="🗓 15 Ekim 2026 (Perşembe)" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                            <TextBlock x:Name="TxtSelectedDaySubtitle" Text="Bu güne ait planlanmış 1 adet ödeme bulunuyor" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Filtre Butonları -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton x:Name="RbFilterSelectedDay" Content="Sadece Seçili Gün" IsChecked="True" 
                                                         Checked="FilterMode_Changed" Margin="0,0,12,0" FontWeight="SemiBold" Foreground="#475569"/>
                                            <RadioButton x:Name="RbFilterAllMonth" Content="Bu Ayın Tümü" 
                                                         Checked="FilterMode_Changed" FontWeight="SemiBold" Foreground="#475569"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Boş Durum (Hiç Hatırlatma Yoksa) -->
                                <Border x:Name="PnlEmptyState" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🎉" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBlock Text="Bu güne ait bekleyen ödeme veya bildirim yok" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        <Button Content="➕ Bu Güne Yeni Bildirim Ekle" Click="AddReminderForSelectedDay_Click" Margin="0,10,0,0"
                                                Background="#EFF6FF" Foreground="#2563EB" FontWeight="Bold" Padding="12,6" BorderBrush="#BFDBFE" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Hatırlatma Kartları Listesi -->
                                <ScrollViewer Grid.Row="1" x:Name="RemindersScrollViewer" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="RemindersItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8FAFC" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/> <!-- Kategori İkonu -->
                                                            <ColumnDefinition Width="*"/>    <!-- Başlık & Açıklama -->
                                                            <ColumnDefinition Width="Auto"/> <!-- Tutar & Aksiyon Butonları -->
                                                        </Grid.ColumnDefinitions>

                                                        <!-- İkon Rozeti -->
                                                        <Border Grid.Column="0" Background="White" CornerRadius="8" Width="44" Height="44" 
                                                                BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CategoryIcon}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Bilgiler -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                                                <Border Background="#E2E8F0" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                                                                </Border>
                                                                <Border Background="#EFF6FF" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding TypeBadge}" FontSize="10" FontWeight="Bold" Foreground="#1E40AF"/>
                                                                </Border>
                                                            </StackPanel>
                                                            
                                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                            
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <TextBlock Text="📅 Vade: " FontSize="11" Foreground="#64748B"/>
                                                                <TextBlock Text="{Binding FormattedDueDate}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,10,0"/>
                                                                <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Tutar & İşlemler -->
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding FormattedAmount}" FontSize="18" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right"/>

                                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" HorizontalAlignment="Right">
                                                                <!-- Ödendi Butonu (Sadece Bekleyenlerde) -->
                                                                <Button Content="💳 Ödendi" Click="MarkPaid_Click"
                                                                        Background="#059669" Foreground="White" FontWeight="Bold" FontSize="12"
                                                                        Padding="10,4" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"
                                                                        ToolTip="Ödeme kaynağını seç (Banka/Nakit) ve otomatik masraf faturası işle">
                                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>

                                                                <!-- Düzenle -->
                                                                <Button Content="✏️" Click="EditReminder_Click"
                                                                        Background="#F1F5F9" Foreground="#334155" Padding="6,4" Margin="0,0,6,0"
                                                                        BorderBrush="#CBD5E1" Cursor="Hand" ToolTip="Düzenle">
                                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                                </Button>

                                                                <!-- Sil -->
                                                                <Button Content="🗑️" Click="DeleteReminder_Click"
                                                                        Background="#FEF2F2" Foreground="#DC2626" Padding="6,4"
                                                                        BorderThickness="0" Cursor="Hand" ToolTip="Sil">
                                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ALT ŞERİT: AYLIK MASRAF & ÖDEME TOPLAMI -->
                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="10" Padding="14,10" Margin="0,16,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📊 Aylık Ödeme Tablosu:" FontWeight="Bold" Foreground="#475569" Margin="0,0,16,0"/>
                                
                                <TextBlock Text="Toplam Masraf: " Foreground="#64748B"/>
                                <TextBlock x:Name="TxtMonthTotal" Text="₺0,00" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,16,0"/>

                                <TextBlock Text="Ödenen: " Foreground="#64748B"/>
                                <TextBlock x:Name="TxtMonthPaid" Text="₺0,00" FontWeight="Bold" Foreground="#059669" Margin="0,0,16,0"/>

                                <TextBlock Text="Kalan Bekleyen: " Foreground="#64748B"/>
                                <TextBlock x:Name="TxtMonthPending" Text="₺0,00" FontWeight="Bold" Foreground="#D97706"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="💡 İpucu: Herhangi bir güne tıklayarak o güne ait bildirimleri görebilirsiniz." 
                                       FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
