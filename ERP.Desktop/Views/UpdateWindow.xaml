<Window x:Class="ERP.Desktop.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni Güncelleme Mevcut"
        Height="440" Width="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="White" CornerRadius="16" BorderBrush="#CBD5E1" BorderThickness="1.5"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.3" Color="Black"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Başlık -->
                <RowDefinition Height="Auto"/> <!-- Sürüm Rozetleri -->
                <RowDefinition Height="*"/>    <!-- Yenilikler Listesi -->
                <RowDefinition Height="Auto"/> <!-- İlerleme Çubuğu -->
                <RowDefinition Height="Auto"/> <!-- Butonlar -->
            </Grid.RowDefinitions>

            <!-- 1. Başlık & Kapat Butonu -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="20" Background="#EFF6FF" Margin="0,0,12,0">
                        <TextBlock Text="🚀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Yeni Güncelleme Bulundu!" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Pure Accessory Otomasyon sistemi için yeni bir sürüm hazır." FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="BtnCloseTop" Content="✕" Click="Cancel_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" Foreground="#64748B" BorderThickness="0"
                        FontSize="16" FontWeight="Bold" Cursor="Hand" Width="30" Height="30"/>
            </Grid>

            <!-- 2. Sürüm Bilgi Rozetleri -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Mevcut Sürüm: " FontSize="12" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtCurrentVer" Text="v1.0.0" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,16,0"/>

                        <TextBlock Text="Yeni Sürüm: " FontSize="12" Foreground="#64748B"/>
                        <Border Background="#DCFCE7" CornerRadius="6" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtRemoteVer" Text="v1.0.1" FontSize="12" FontWeight="Bold" Foreground="#15803D"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="TxtReleaseDate" Text="Yayın Tarihi: 09.10.2026" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 3. Değişiklik Listesi (Changelog) -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📋 Sürüm Yenilikleri &amp; İyileştirmeler:" FontSize="12" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtChangeLog" Text="• Performans iyileştirmeleri ve hata düzeltmeleri yapıldı." FontSize="12" Foreground="#475569" TextWrapping="Wrap" LineHeight="18"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 4. İndirme Durumu & İlerleme Çubuğu -->
            <StackPanel x:Name="PanelProgress" Grid.Row="3" Margin="0,0,0,14" Visibility="Collapsed">
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="TxtProgressStatus" Text="Güncelleme paketi indiriliyor..." FontSize="12" FontWeight="SemiBold" Foreground="#2563EB"/>
                    <TextBlock x:Name="TxtProgressPct" Text="%0" FontSize="12" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar x:Name="ProgressBarDownload" Height="10" Minimum="0" Maximum="100" Value="0" Background="#E2E8F0" Foreground="#2563EB" BorderThickness="0">
                    <ProgressBar.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </ProgressBar.Resources>
                </ProgressBar>
            </StackPanel>

            <!-- 5. Alt Butonlar -->
            <Grid Grid.Row="4">
                <Button x:Name="BtnLater" Content="Daha Sonra" Click="Cancel_Click" HorizontalAlignment="Left"
                        Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" FontSize="13"
                        Padding="18,10" BorderBrush="#CBD5E1" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>

                <Button x:Name="BtnUpdateNow" Content="⚡ Şimdi Güncelle ve Yeniden Başlat" Click="UpdateNow_Click" HorizontalAlignment="Right"
                        Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="13"
                        Padding="20,10" BorderThickness="0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
