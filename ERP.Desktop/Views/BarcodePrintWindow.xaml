<Window x:Class="ERP.Desktop.Views.BarcodePrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Barkod Oluşturma &amp; Etiket Baskı Merkezi" Height="780" Width="1080"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Başlık -->
            <RowDefinition Height="*"/>    <!-- Ana İçerik (Ürünler + Ayarlar & Önizleme) -->
            <RowDefinition Height="Auto"/> <!-- Alt Bilgi ve Aksiyonlar -->
        </Grid.RowDefinitions>

        <!-- 1. ÜST PANEL -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20,14" Margin="0,0,0,15"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🏷️ Barkod Oluşturma &amp; Etiket Baskı Merkezi" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Ürünlerinize özel barkod tanımlayın, etiket adetlerini seçin ve A4 ya da Termal rulo formatında PDF baskı alın." FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚡ Barkodu Olmayanlara Otomatik Barkod Üret" Click="AutoGenerateMissingBarcodes_Click"
                            Background="#EFF6FF" Foreground="#2563EB" FontWeight="Bold" FontSize="13"
                            Padding="14,8" BorderBrush="#BFDBFE" BorderThickness="1" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. ANA PANEL (İKİ SÜTUN) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- SOL SÜTUN: ÜRÜN LİSTESİ VE SEÇİM -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,15,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Arama & Hızlı Seçim -->
                        <RowDefinition Height="*"/>    <!-- Tablo -->
                        <RowDefinition Height="Auto"/> <!-- Hızlı Adet Araçları -->
                    </Grid.RowDefinitions>

                    <!-- Arama & Filtre -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="36" Padding="10,0" FontSize="13" VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged" ToolTip="Ürün adı, kodu veya barkod ile filtreleyin..."/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Content="Tümünü Seç" Click="SelectAll_Click" Padding="10,6" Margin="0,0,6,0"
                                    Background="#F1F5F9" Foreground="#334155" FontSize="12" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="Temizle" Click="DeselectAll_Click" Padding="10,6"
                                    Background="#F1F5F9" Foreground="#334155" FontSize="12" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Tablo -->
                    <DataGrid x:Name="GridItems" Grid.Row="1" AutoGenerateColumns="False" Background="White"
                              BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="38" ColumnHeaderHeight="36"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                              SelectionChanged="GridItems_SelectionChanged">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <!-- Seçim Onay Kutusu -->
                            <DataGridTemplateColumn Width="42">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Checked="ItemCheckbox_Changed" Unchecked="ItemCheckbox_Changed"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Kod" Binding="{Binding Product.Code}" Width="75" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Ürün Adı" Binding="{Binding Product.Name}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Barkod" Binding="{Binding Product.Barcode}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Fiyat" Binding="{Binding Product.FormattedSalePrice}" Width="80" IsReadOnly="True"/>
                            
                            <!-- Baskı Adedi -->
                            <DataGridTemplateColumn Header="Baskı Adedi" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding PrintCount, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="65" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 TextChanged="PrintCount_TextChanged" FontSize="13" FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Hızlı Barkod Üret -->
                            <DataGridTemplateColumn Header="İşlem" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="⚡ Üret" Click="GenerateRowBarcode_Click" Padding="6,2"
                                                Background="#F8FAFC" Foreground="#2563EB" FontSize="11" FontWeight="SemiBold"
                                                BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" ToolTip="Bu ürüne özel yeni EAN-13 barkod oluştur">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Hızlı Adet Belirleme Çubuğu -->
                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Toplu Adet:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="Her birinden 1 Adet" Click="SetAllQty1_Click" Margin="0,0,6,0" Padding="8,4" Background="#F1F5F9" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="Her birinden 5 Adet" Click="SetAllQty5_Click" Margin="0,0,6,0" Padding="8,4" Background="#F1F5F9" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="Mevcut Stok Kadar" Click="SetAllQtyStock_Click" Padding="8,4" Background="#EFF6FF" Foreground="#2563EB" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- SAĞ SÜTUN: ETİKET VE BASKI AYARLARI + CANLI ÖNİZLEME -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="⚙️ Baskı ve Şablon Ayarları" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                        <!-- Kağıt / Etiket Şablonu -->
                        <TextBlock Text="Etiket Kağıdı / Şablonu" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbPaperFormat" Height="36" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,12" SelectionChanged="OptionsChanged_Trigger">
                            <ComboBoxItem Content="A4 Sayfa - 24 Etiket (3 Sütun x 8 Satır)" Tag="A4_24Labels" IsSelected="True"/>
                            <ComboBoxItem Content="A4 Sayfa - 30 Etiket (3 Sütun x 10 Satır)" Tag="A4_30Labels"/>
                            <ComboBoxItem Content="A4 Sayfa - 40 Etiket (4 Sütun x 10 Satır)" Tag="A4_40Labels"/>
                            <ComboBoxItem Content="Termal Rulo Etiket (60 x 40 mm)" Tag="Thermal_60x40"/>
                            <ComboBoxItem Content="Termal Rulo Etiket (50 x 30 mm)" Tag="Thermal_50x30"/>
                        </ComboBox>

                        <!-- Mağaza Adı -->
                        <TextBlock Text="Firma / Mağaza Başlığı" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtStoreName" Text="ERP MARKET" Height="34" Padding="8,0" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,12" TextChanged="OptionsChanged_Trigger"/>

                        <!-- Görünüm Seçenekleri -->
                        <TextBlock Text="Etiket Üzerinde Gösterilecekler" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                        <StackPanel Margin="0,0,0,14">
                            <CheckBox x:Name="ChkShowStoreName" Content="Mağaza Başlığı" IsChecked="True" Margin="0,0,0,5" Checked="OptionsChanged_Trigger" Unchecked="OptionsChanged_Trigger"/>
                            <CheckBox x:Name="ChkShowProductName" Content="Ürün Adı" IsChecked="True" Margin="0,0,0,5" Checked="OptionsChanged_Trigger" Unchecked="OptionsChanged_Trigger"/>
                            <CheckBox x:Name="ChkShowPrice" Content="Satış Fiyatı" IsChecked="True" Margin="0,0,0,5" Checked="OptionsChanged_Trigger" Unchecked="OptionsChanged_Trigger"/>
                            <CheckBox x:Name="ChkShowBarcodeText" Content="Barkod Numarası" IsChecked="True" Margin="0,0,0,5" Checked="OptionsChanged_Trigger" Unchecked="OptionsChanged_Trigger"/>
                            <CheckBox x:Name="ChkShowQrCode" Content="QR Kod Ekle (İsteğe Bağlı)" IsChecked="False" Checked="OptionsChanged_Trigger" Unchecked="OptionsChanged_Trigger"/>
                        </StackPanel>

                        <!-- CANLI ETİKET ÖNİZLEME -->
                        <TextBlock Text="👁️ Canlı Etiket Önizlemesi" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
                        <Border x:Name="LabelPreviewCard" Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1.5" CornerRadius="6" Padding="14,12" Margin="0,0,0,15" MinHeight="140">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtPreviewStore" Text="ERP MARKET" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                <TextBlock x:Name="TxtPreviewProduct" Text="Örnek Ürün Adı" FontSize="13" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,4"/>
                                <Image x:Name="ImgPreviewBarcode" Height="42" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                <TextBlock x:Name="TxtPreviewCode" Text="8690000000000" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtPreviewPrice" Text="₺0,00" FontSize="16" FontWeight="Black" Foreground="#0F172A" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- ÖZET BİLGİ KUTUSU -->
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="12" Margin="0,0,0,5">
                            <StackPanel>
                                <TextBlock x:Name="TxtSummarySelection" Text="Seçilen: 0 Ürün" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                                <TextBlock x:Name="TxtSummaryLabels" Text="Toplam Basılacak Etiket: 0 Adet" FontSize="13" FontWeight="Bold" Foreground="#2563EB" Margin="0,3,0,0"/>
                                <TextBlock x:Name="TxtSummaryPages" Text="Tahmini Sayfa Sayısı: 0 Sayfa" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 3. ALT AKSİYON PANELİ -->
        <Border Grid.Row="2" Margin="0,15,0,0" Padding="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Kapat" Click="Close_Click" Padding="18,10"
                        Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="💾 PDF Olarak Kaydet" Click="SavePdf_Click" Margin="0,0,10,0" Padding="20,10"
                            Background="#F1F5F9" Foreground="#1E293B" FontWeight="Bold" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>

                    <Button Content="📄 PDF Oluştur &amp; Aç" Click="GenerateAndOpenPdf_Click" Padding="24,10"
                            Background="#059669" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
