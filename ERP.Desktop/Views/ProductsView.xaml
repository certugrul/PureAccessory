<Page x:Class="ERP.Desktop.Views.ProductsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F8FAFC">

    <Grid Margin="10,5,10,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK & YENİ ÜRÜN BUTONU -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,15"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Ürün ve Stok Yönetimi" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Sisteme kayıtlı ürünler, barkod/QR kod tanımları, alış/satış fiyatları ve stok adetleri" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ProductCountText" Text="5 Ürün Kayıtlı" FontSize="14" FontWeight="SemiBold" 
                               Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource PrimaryLightBrush}" Padding="12,8" Margin="0,0,12,0" VerticalAlignment="Center"/>

                    <Button Content="🖨️ Barkod / Etiket Baskı" Click="OpenBarcodeCenter_Click"
                            Background="#059669" Foreground="White" FontWeight="Bold" FontSize="14"
                            Padding="16,10" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="➕ Yeni Ürün Ekle" Click="AddProduct_Click"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" FontSize="14"
                            Padding="18,10" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ARAMA VE FİLTRE ÇUBUĞU -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,15"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Width="360" Height="40" Padding="12,8" FontSize="14"
                         VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown"
                         ToolTip="Ürün adı, barkod, QR kod veya ürün kodu yazıp arayın..."/>
                <Button Content="🔍 Ürün / QR Ara" Click="Search_Click" Margin="10,0,0,0" Padding="20,8"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Tümünü Göster" Click="Reset_Click" Margin="10,0,0,0" Padding="16,8"
                        Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- ÜRÜNLER TABLOSU (İŞLEMLER SÜTUNU DAHİL) -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid x:Name="ProductGrid" AutoGenerateColumns="False" Background="White"
                      BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="42" ColumnHeaderHeight="40"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                      HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ürün Kodu" Binding="{Binding Code}" Width="95"/>
                    <DataGridTextColumn Header="Ürün Adı" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="QR Kod" Binding="{Binding QrCode}" Width="130"/>
                    <DataGridTextColumn Header="Barkod" Binding="{Binding Barcode}" Width="130"/>
                    <DataGridTextColumn Header="Alış Fiyatı" Binding="{Binding FormattedPurchasePrice}" Width="100"/>
                    <DataGridTextColumn Header="Satış Fiyatı" Binding="{Binding FormattedSalePrice}" Width="100"/>
                    <DataGridTextColumn Header="KDV %" Binding="{Binding VatRate, StringFormat={}%{0:0}}" Width="75"/>
                    <DataGridTextColumn Header="Stok" Binding="{Binding FormattedStock}" Width="105"/>

                    <!-- İŞLEM BUTONLARI (ETİKET, DÜZENLE & SİL) -->
                    <DataGridTemplateColumn Header="İşlemler" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="🏷️ Etiket" Click="PrintProductLabel_Click" Margin="0,0,6,0" Padding="8,4"
                                            Background="#ECFDF5" Foreground="#059669" FontWeight="SemiBold" FontSize="12"
                                            BorderBrush="#A7F3D0" BorderThickness="1" Cursor="Hand" ToolTip="Bu ürün için etiket / barkod PDF baskısı al">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Content="✏️ Düzenle" Click="EditProduct_Click" Margin="0,0,6,0" Padding="8,4"
                                            Background="{DynamicResource PrimaryLightBrush}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" FontSize="12"
                                            BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Content="🗑️ Sil" Click="DeleteProduct_Click" Padding="8,4"
                                            Background="#FEF2F2" Foreground="#DC2626" FontWeight="SemiBold" FontSize="12"
                                            BorderBrush="#FECACA" BorderThickness="1" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
