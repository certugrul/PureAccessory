<Window x:Class="ERP.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistem &amp; Tema Ayarları"
        Width="580" Height="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="White" CornerRadius="16" BorderBrush="#CBD5E1" BorderThickness="1.5"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Başlık & Kapat Butonu -->
                <RowDefinition Height="*"/>    <!-- Ayarlar İçeriği -->
                <RowDefinition Height="Auto"/> <!-- Butonlar -->
            </Grid.RowDefinitions>

            <!-- 1. Üst Başlık & Kapat -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="19" Background="#EFF6FF" Margin="0,0,10,0">
                        <TextBlock Text="⚙️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sistem &amp; Görünüm Ayarları" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Tema renkleri, marka başlığı ve kişiselleştirme tercihleri" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <Button Content="✕" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" Foreground="#64748B" BorderThickness="0"
                        FontSize="16" FontWeight="Bold" Cursor="Hand" Width="30" Height="30"/>
            </Grid>

            <!-- 2. Ayarlar İçeriği (Kaydırılabilir) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Bölüm 1: Mağaza & Marka Bilgisi -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="🏷️ Marka &amp; Mağaza Bilgisi" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>

                            <TextBlock Text="Mağaza / Sistem Adı:" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtStoreName" Height="36" Padding="8,0" VerticalContentAlignment="Center"
                                     FontSize="13" FontWeight="SemiBold" BorderBrush="#CBD5E1" Margin="0,0,0,10"/>

                            <TextBlock Text="Alt Başlık / Slogan:" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtSubtitle" Height="36" Padding="8,0" VerticalContentAlignment="Center"
                                     FontSize="13" BorderBrush="#CBD5E1"/>
                        </StackPanel>
                    </Border>

                    <!-- Bölüm 2: Ana Tema Rengi -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="🎨 Ana Tema Rengi (Vurgu Rengi)" FontSize="13" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock x:Name="TxtSelectedColorName" Text="Klasik Mavi" FontSize="11.5" FontWeight="SemiBold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Butonlar, vurgular, rozetler ve aktif menülerde kullanılacak renk tonu (Tıklayarak anlık canlı önizleyin)" FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>

                            <WrapPanel x:Name="PanelColors" Orientation="Horizontal">
                                <!-- Mavi -->
                                <Border x:Name="ColorBlue" MouseLeftButtonDown="SelectPrimaryColor_Click" Tag="#2563EB"
                                        Background="#2563EB" Width="44" Height="44" CornerRadius="22" Margin="0,0,10,8" Cursor="Hand"
                                        BorderThickness="3" BorderBrush="#BFDBFE" ToolTip="Klasik Mavi"/>
                                <!-- İndigo / Gece Mavisi -->
                                <Border x:Name="ColorIndigo" MouseLeftButtonDown="SelectPrimaryColor_Click" Tag="#4F46E5"
                                        Background="#4F46E5" Width="44" Height="44" CornerRadius="22" Margin="0,0,10,8" Cursor="Hand"
                                        BorderThickness="3" BorderBrush="Transparent" ToolTip="Modern İndigo"/>
                                <!-- Turkuaz / Okyanus -->
                                <Border x:Name="ColorTeal" MouseLeftButtonDown="SelectPrimaryColor_Click" Tag="#0D9488"
                                        Background="#0D9488" Width="44" Height="44" CornerRadius="22" Margin="0,0,10,8" Cursor="Hand"
                                        BorderThickness="3" BorderBrush="Transparent" ToolTip="Okyanus Turkuazı"/>
                                <!-- Zümrüt Yeşili -->
                                <Border x:Name="ColorEmerald" MouseLeftButtonDown="SelectPrimaryColor_Click" Tag="#059669"
                                        Background="#059669" Width="44" Height="44" CornerRadius="22" Margin="0,0,10,8" Cursor="Hand"
                                        BorderThickness="3" BorderBrush="Transparent" ToolTip="Zümrüt Yeşili"/>
                                <!-- Asil Mor -->
                                <Border x:Name="ColorPurple" MouseLeftButtonDown="SelectPrimaryColor_Click" Tag="#7C3AED"
                                        Background="#7C3AED" Width="44" Height="44" CornerRadius="22" Margin="0,0,10,8" Cursor="Hand"
                                        BorderThickness="3" BorderBrush="Transparent" ToolTip="Kraliyet Moru"/>
                                <!-- Yakut Kırmızı -->
                                <Border x:Name="ColorRose" MouseLeftButtonDown="SelectPrimaryColor_Click" Tag="#E11D48"
                                        Background="#E11D48" Width="44" Height="44" CornerRadius="22" Margin="0,0,10,8" Cursor="Hand"
                                        BorderThickness="3" BorderBrush="Transparent" ToolTip="Yakut Kırmızı"/>
                                <!-- Kehribar Turuncu -->
                                <Border x:Name="ColorAmber" MouseLeftButtonDown="SelectPrimaryColor_Click" Tag="#D97706"
                                        Background="#D97706" Width="44" Height="44" CornerRadius="22" Margin="0,0,10,8" Cursor="Hand"
                                        BorderThickness="3" BorderBrush="Transparent" ToolTip="Kehribar Turuncu"/>
                                <!-- Grafit Koyu -->
                                <Border x:Name="ColorSlate" MouseLeftButtonDown="SelectPrimaryColor_Click" Tag="#334155"
                                        Background="#334155" Width="44" Height="44" CornerRadius="22" Margin="0,0,10,8" Cursor="Hand"
                                        BorderThickness="3" BorderBrush="Transparent" ToolTip="Grafit Koyu"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Bölüm 3: Görünüm Modu & Arka Plan (Açık / Koyu / Gri) -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="🌓 Görünüm Modu &amp; Sayfa Arka Planı" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                            <TextBlock Text="Çalışma ortamınıza göre genel arka plan kontrastını belirleyin" FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>

                            <UniformGrid Columns="3">
                                <RadioButton x:Name="RbModeLight" Content="☀️ Açık (Temiz)" IsChecked="True" Checked="ModeOption_Checked" Tag="Açık" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                                <RadioButton x:Name="RbModeSoft" Content="🌫️ Yumuşak Gri" Checked="ModeOption_Checked" Tag="Yumuşak Gri" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                                <RadioButton x:Name="RbModeDark" Content="🌙 Koyu (Gece)" Checked="ModeOption_Checked" Tag="Koyu" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Bölüm 4: Sol Menü (Sidebar) Teması -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="🌑 Sol Menü (Sidebar) Tonu" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                            <TextBlock Text="Sol navigasyon menüsünün arka plan görünümünü seçiniz" FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>

                            <UniformGrid Columns="3">
                                <RadioButton x:Name="RbSidebarDark" Content="Gece Siyahı" IsChecked="True"
                                             Checked="SidebarColor_Checked" Tag="#111827" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                                <RadioButton x:Name="RbSidebarNavy" Content="Koyu Lacivert"
                                             Checked="SidebarColor_Checked" Tag="#0F172A" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                                <RadioButton x:Name="RbSidebarSlate" Content="Grafit Füme"
                                             Checked="SidebarColor_Checked" Tag="#1E293B" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Bölüm 5: Yazı Tipi (Tipografi) -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="🔤 Yazı Tipi (Font Ailesi)" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                            <TextBlock Text="Ekrandaki metinlerin görünüm stilini belirleyin" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>

                            <ComboBox x:Name="CmbFontFamily" Height="34" SelectionChanged="FontFamily_SelectionChanged" FontSize="12">
                                <ComboBoxItem Content="Segoe UI (Modern Varsayılan)" Tag="Segoe UI" IsSelected="True"/>
                                <ComboBoxItem Content="Arial (Klasik &amp; Okunaklı)" Tag="Arial"/>
                                <ComboBoxItem Content="Calibri (Yumuşak Çizgiler)" Tag="Calibri"/>
                                <ComboBoxItem Content="Verdana (Geniş &amp; Net)" Tag="Verdana"/>
                                <ComboBoxItem Content="Trebuchet MS (Karakteristik)" Tag="Trebuchet MS"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Bölüm 6: Kullanıcı Tercihleri & Ses -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="⚡ Ek Özellikler &amp; Tercihler" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkSound" Content="🔊 Satış ve işlem onay ses efektleri aktif" 
                                          IsChecked="True" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="🔔 Sesi Sına" Click="TestSound_Click" Padding="8,4"
                                        Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" BorderThickness="1"
                                        FontSize="11" FontWeight="Bold" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                            </Grid>

                            <CheckBox x:Name="ChkAutoPrint" Content="🖨️ Satış tamamlandığında otomatik fiş yazdır" 
                                      IsChecked="False" Margin="0,0,0,8" FontSize="12" FontWeight="SemiBold"/>

                            <CheckBox x:Name="ChkCompactMode" Content="📐 Kompakt arayüz görünümü (Küçük ekranlar için daraltılmış menü)" 
                                      IsChecked="False" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Bölüm 7: Fiş Başlık ve Alt Not Özelleştirmesi -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="🧾 Fiş Çıktısı Özel Başlık ve Notu" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                            <TextBlock Text="Yazdırılan fişlerin ve PDF raporlarının üzerinde görünecek kurumsal metinler" FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>

                            <TextBlock Text="Fiş Başlığı:" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtReceiptHeader" Height="32" Padding="8,0" VerticalContentAlignment="Center" FontSize="12" BorderBrush="#CBD5E1" Margin="0,0,0,8"/>

                            <TextBlock Text="Fiş Altı Teşekkür / Bilgi Notu:" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtReceiptFooter" Height="32" Padding="8,0" VerticalContentAlignment="Center" FontSize="12" BorderBrush="#CBD5E1"/>
                        </StackPanel>
                    </Border>

                    <!-- Bölüm 8: Uzaktan Güncelleme & Sürüm -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="🔄 Uzaktan Güncelleme &amp; Sürüm" FontSize="13" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock x:Name="TxtAppVersionLabel" Text="Sürüm: v1.0.8" FontSize="12" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Uygulama açılışında sunucuyu denetler ve yeni sürüm varsa otomatik indirir." FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>

                            <TextBlock Text="Güncelleme URL'si (GitHub Releases veya version.json):" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtUpdateUrl" Height="34" Padding="8,0" VerticalContentAlignment="Center" FontSize="12" BorderBrush="#CBD5E1"
                                         ToolTip="Örnek GitHub: https://github.com/kullanici/proje veya https://api.github.com/repos/kullanici/proje/releases/latest"/>
                                <Button Grid.Column="1" Content="🔍 Güncellemeleri Denetle" Click="CheckUpdates_Click" Margin="8,0,0,0" Padding="12,0"
                                         Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" FontWeight="Bold" FontSize="11.5" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                            </Grid>

                            <!-- Manuel Güncelleme Paketi Yükle -->
                            <Button Content="📦 Manuel Güncelleme Paketi Yükle (.zip Dosyası)" Click="InstallLocalZipUpdate_Click" Margin="0,0,0,10" Padding="12,8"
                                    Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" FontWeight="Bold" FontSize="11.5" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>

                            <CheckBox x:Name="ChkAutoUpdate" Content="ERP açılışında yeni sürümleri otomatik kontrol et" IsChecked="True" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Bölüm 6: Şube & Mağaza Veri Senkronizasyonu (Veri Gönder & Al) -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="📡 Şube &amp; Mağaza Veri Senkronizasyonu" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                            <TextBlock Text="Mağazada yapılan satışları, ciroyu ve kasa hareketlerini merkeze aktarın veya merkezden gelen düzeltmeleri uygulayın." FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>

                            <!-- Aksiyon Butonları -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- 1. Mağaza Verilerini Gönder / Paketle -->
                                <Button Grid.Column="0" Click="ExportBranchData_Click" Margin="0,0,6,0" Padding="12,10"
                                        Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="📤" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Mağaza Verilerini Gönder" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="Satış &amp; ciroyu paketle (.sync)" FontSize="10" Foreground="#64748B"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <!-- 2. Merkezden Gelen Düzeltmeyi Uygula -->
                                <Button Grid.Column="1" Click="ApplyCorrectionPackage_Click" Margin="6,0,0,0" Padding="12,10"
                                        Background="#F0FDF4" Foreground="#15803D" BorderBrush="#BBF7D0" BorderThickness="1" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="📥" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Düzeltmeleri Uygula" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="Merkezden gelen paketi yükle" FontSize="10" Foreground="#64748B"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Otomatik Gönderim Seçeneği -->
                            <Border Background="#F1F5F9" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkAutoSyncOnClosure" Content="⚡ Gün sonu (Z Raporu) yapıldığında değişen verileri otomatik merkeze gönder" 
                                              IsChecked="True" FontSize="12" FontWeight="Bold" Foreground="#1E293B"/>
                                    <TextBlock Text="Kapanış alındığında satış, ciro ve kasa verileri otomatik paketlenir, hedef klasöre ve varsa merkezi SQL'e anında aktarılır." 
                                               FontSize="11" Foreground="#64748B" Margin="22,3,0,6"/>

                                    <Grid Margin="22,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtAutoSyncTargetDir" Height="30" Padding="8,0" VerticalContentAlignment="Center" FontSize="11" BorderBrush="#CBD5E1"
                                                 ToolTip="Otomatik kaydedilecek klasör yolu (Örn: Google Drive, OneDrive veya Masaüstü)"/>
                                        <Button Grid.Column="1" Content="📁 Klasör Seç" Click="SelectAutoSyncDir_Click" Margin="6,0,0,0" Padding="10,0"
                                                Background="#E2E8F0" Foreground="#334155" FontWeight="SemiBold" FontSize="11" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 3. Yönetici / Merkez İnceleme Butonu -->
                            <Button Click="OpenSyncReview_Click" Padding="12,10"
                                    Background="#1E293B" Foreground="White" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🔍" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Şube Veri İnceleme &amp; Senkronizasyon Merkezi (Yönetici)" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="Gelen satışları incele, düzelt ve merkeze/mağazaya aktar" FontSize="10" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Bölüm 7: Merkezi SQL Server Bağlantısı (İsteğe Bağlı) -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="🗄️ Uzak / Merkezi SQL Server Bağlantısı" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                            <TextBlock Text="Başka bir bilgisayara kurulduğunda ana bilgisayarın IP adresini buraya girebilirsiniz (Boş bırakılırsa yerel sunucu kullanılır)." FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>

                            <TextBox x:Name="TxtCustomDbConn" Height="34" Padding="8,0" VerticalContentAlignment="Center" FontSize="11" BorderBrush="#CBD5E1"
                                     ToolTip="Örnek: Server=192.168.1.100;Database=ERPSystem;User Id=sa;Password=...;TrustServerCertificate=True;"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="🔌 Bağlantıyı Test Et" Click="TestDbConn_Click" Margin="0,0,4,0" Padding="10,8"
                                        Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" FontWeight="Bold" FontSize="11.5" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Grid.Column="1" Content="🔍 Yerel SQL'i Otomatik Algıla" Click="AutoDetectDb_Click" Margin="4,0,0,0" Padding="10,8"
                                        Background="#F0FDF4" Foreground="#15803D" BorderBrush="#BBF7D0" FontWeight="Bold" FontSize="11.5" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Alt Butonlar -->
            <Grid Grid.Row="2">
                <Button Content="İptal" Click="Close_Click" HorizontalAlignment="Left"
                        Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" FontSize="13"
                        Padding="20,10" BorderBrush="#CBD5E1" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>

                <Button Content="💾 Değişiklikleri Kaydet &amp; Uygula" Click="Save_Click" HorizontalAlignment="Right"
                        Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="13"
                        Padding="24,10" BorderThickness="0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
