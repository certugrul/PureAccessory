<Window x:Class="ERP.Desktop.Views.WarehouseTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Depolar Arası Stok Transferi" Height="480" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="🔄 Depolar Arası Stok Transferi" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Bir depodaki ürünü başka bir depoya transfer edin" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Form Alanları -->
            <StackPanel Grid.Row="1">
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Çıkış Deposu -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Kaynak Depo (Çıkış) *" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbSourceWarehouse" Height="40" DisplayMemberPath="DisplayText"
                                  SelectionChanged="CmbSourceWarehouse_SelectionChanged" BorderBrush="#CBD5E1"/>
                    </StackPanel>
                    <!-- Giriş Deposu -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Hedef Depo (Giriş) *" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbTargetWarehouse" Height="40" DisplayMemberPath="DisplayText" BorderBrush="#CBD5E1"/>
                    </StackPanel>
                </Grid>

                <!-- Transfer Edilecek Ürün -->
                <TextBlock Text="Transfer Edilecek Ürün *" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbProduct" Height="40" DisplayMemberPath="DisplayInfo"
                          SelectionChanged="CmbProduct_SelectionChanged" BorderBrush="#CBD5E1" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtSourceAvailableStock" Text="Kaynak Depo Mevcut Stok: -" FontSize="12" FontWeight="SemiBold"
                           Foreground="#059669" Margin="0,0,0,14"/>

                <!-- Transfer Miktarı -->
                <TextBlock Text="Transfer Edilecek Miktar (Adet) *" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtQuantity" Height="40" FontSize="15" FontWeight="Bold" Padding="10,0" VerticalContentAlignment="Center"
                         BorderBrush="#CBD5E1" Text="1" Margin="0,0,0,14"/>

                <!-- Açıklama / Not -->
                <TextBlock Text="Transfer Açıklaması / Not" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtDescription" Height="40" FontSize="14" Padding="10,0" VerticalContentAlignment="Center"
                         BorderBrush="#CBD5E1" Margin="0,0,0,10"/>
            </StackPanel>

            <!-- Butonlar -->
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="İptal" Click="Cancel_Click" Margin="0,0,8,0" Height="42"
                        Background="#F1F5F9" Foreground="#475569" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Grid.Column="1" Content="🔄 Transferi Gerçekleştir" Click="Transfer_Click" Margin="8,0,0,0" Height="42"
                        Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
