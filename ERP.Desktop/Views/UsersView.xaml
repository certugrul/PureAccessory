<Page x:Class="ERP.Desktop.Views.UsersView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F8FAFC">

    <Grid Margin="15,10,15,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Üst Başlık -->
            <RowDefinition Height="*"/>    <!-- Ana İçerik (Liste & Form) -->
        </Grid.RowDefinitions>

        <!-- 1. ÜST BAŞLIK BARI -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,15"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="👥 Kullanıcı &amp; Yetki Yönetim Paneli" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Yeni kullanıcı tanımlama, giriş PIN şifresi belirleme, modül erişimlerini ve kritik işlem yetkilerini kısıtlama/açma" 
                               FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="8" Padding="14,6" BorderBrush="#BFDBFE" BorderThickness="1">
                    <TextBlock Text="🛡️ Yönetici Yetki Modülü Aktif" FontSize="12" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- 2. ANA İÇERİK (2 SÜTUN: SOL LİSTE, SAĞ DÜZENLEME PANELİ) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/> <!-- Kullanıcı Listesi -->
                <ColumnDefinition Width="*"/>   <!-- İzin ve Bilgi Düzenleme Paneli -->
            </Grid.ColumnDefinitions>

            <!-- SOL PANEL: KULLANICI LİSTESİ -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,15,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Arama & Ekle Butonu -->
                        <RowDefinition Height="*"/>    <!-- Liste -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button Content="➕ Yeni Kullanıcı Tanımla" Click="NewUser_Click"
                                Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="13"
                                Padding="0,11" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>

                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                            <TextBox x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged" Height="36"
                                     Padding="10,0" VerticalContentAlignment="Center" FontSize="13"
                                     BorderThickness="0" Background="Transparent"/>
                        </Border>
                    </StackPanel>

                    <!-- Kullanıcı Listesi -->
                    <ListBox x:Name="LstUsers" Grid.Row="1" SelectionChanged="LstUsers_SelectionChanged"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="UserCardBorder" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5"
                                        CornerRadius="10" Padding="12" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar İkon -->
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#EFF6FF"
                                                BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,12,0">
                                            <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Kullanıcı Bilgisi -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="@" FontSize="12" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding Username}" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                                <TextBlock Text=" • PIN: " FontSize="12" Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding PinCode}" FontSize="12" Foreground="#2563EB" FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Rol ve Durum Rozeti -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border Background="#1E293B" CornerRadius="6" Padding="6,2" Margin="0,0,0,3">
                                                <TextBlock Text="{Binding Role}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding StatusDisplayName}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- SAĞ PANEL: DETAYLI YETKİLENDİRME & DÜZENLEME FORMU -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Form Başlığı & Hızlı Şablon Butonları -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtFormTitle" Text="Kullanıcı Düzenleme" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Bilgileri ve modül/işlem kısıtlamalarını yapılandırın" FontSize="12" Foreground="#64748B"/>
                            </StackPanel>

                            <!-- Hızlı Yetki Şablonları -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Hızlı Şablon:" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Margin="0,0,8,0"/>
                                <Button Content="👑 Tam Yetki (Admin)" Click="TemplateAdmin_Click" Margin="0,0,6,0"
                                        Background="#F1F5F9" Foreground="#1E293B" FontWeight="SemiBold" FontSize="11" Padding="10,6" BorderBrush="#CBD5E1">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="👤 Standart Kasiyer" Click="TemplateKasiyer_Click" Margin="0,0,6,0"
                                        Background="#F1F5F9" Foreground="#1E293B" FontWeight="SemiBold" FontSize="11" Padding="10,6" BorderBrush="#CBD5E1">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="🚫 Tümünü Kapat" Click="TemplateNone_Click"
                                        Background="#FEF2F2" Foreground="#DC2626" FontWeight="SemiBold" FontSize="11" Padding="10,6" BorderBrush="#FECACA">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#F1F5F9" Margin="0,0,0,16"/>

                        <!-- 1. GRUP: TEMEL HESAP BİLGİLERİ -->
                        <TextBlock Text="1. Temel Hesap &amp; Giriş Bilgileri" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Ad Soyad -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="Ad Soyad *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtFullName" Height="36" Padding="8,0" VerticalContentAlignment="Center" FontSize="13" BorderBrush="#CBD5E1"/>
                            </StackPanel>

                            <!-- Kullanıcı Adı -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,12">
                                <TextBlock Text="Kullanıcı Adı (Giriş Adı) *" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtUsername" Height="36" Padding="8,0" VerticalContentAlignment="Center" FontSize="13" BorderBrush="#CBD5E1"/>
                            </StackPanel>

                            <!-- Rol / Görev -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Yetki Rolü" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbRole" Height="36" VerticalContentAlignment="Center" FontSize="13">
                                    <ComboBoxItem Content="Kasiyer" IsSelected="True"/>
                                    <ComboBoxItem Content="Admin"/>
                                    <ComboBoxItem Content="Müdür"/>
                                    <ComboBoxItem Content="Depo"/>
                                    <ComboBoxItem Content="Özel"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Giriş PIN / Şifresi -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Giriş Şifresi / PIN (1-6 Hane) *" FontSize="12" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtPinCode" Height="36" Padding="8,0" VerticalContentAlignment="Center" 
                                         FontSize="15" FontWeight="Bold" Foreground="#2563EB" BorderBrush="#93C5FD"/>
                            </StackPanel>
                        </Grid>

                        <!-- Aktif / Pasif Durum -->
                        <CheckBox x:Name="ChkIsActive" Content="Kullanıcı Hesabı Aktif (İşaret kaldırılırsa kullanıcı sisteme giriş yapamaz)" 
                                  IsChecked="True" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,16"/>

                        <Separator Background="#F1F5F9" Margin="0,0,0,16"/>

                        <!-- 2. GRUP: MODÜL ERİŞİM İZİNLERİ (HER ŞEYİ AÇIP KAPATABİLME) -->
                        <TextBlock Text="2. Modül Erişim Yetkileri (Sol Menü Kısıtlamaları)" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                        <TextBlock Text="Kullanıcının erişmesini istemediğiniz modüllerin onay kutusunu kaldırınız. Kısıtlanan modüller kullanıcının menüsünde hiç görünmez." 
                                   FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <UniformGrid Columns="2">
                                <CheckBox x:Name="ChkSales" Content="🛒 Satış Ekranı (Hızlı Satış &amp; Barkod)" Margin="0,6" FontSize="13" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkProducts" Content="📦 Ürünler (Stok Listesi &amp; Ekleme)" Margin="0,6" FontSize="13" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkWarehouse" Content="🏭 Depo Yönetimi &amp; Stok Sayımı" Margin="0,6" FontSize="13" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkCari" Content="👥 Cari Hesaplar (Müşteri &amp; Tedarikçi)" Margin="0,6" FontSize="13" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkCash" Content="💵 Kasa Modülü (Nakit &amp; Masraf Girişi)" Margin="0,6" FontSize="13" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkBank" Content="🏦 Banka Hesapları &amp; Transferler" Margin="0,6" FontSize="13" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkDebts" Content="💳 Borç &amp; Finans (Kredi Kartı, KMH, Taksitler)" Margin="0,6" FontSize="13" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkInvoices" Content="🧾 Faturalar (Alış &amp; Masraf Girişi)" Margin="0,6" FontSize="13" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkReports" Content="📊 Raporlar, PDF &amp; Geçmiş Arşiv" Margin="0,6" FontSize="13" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkDashboard" Content="⚙️ Yönetim Paneli (Hatırlatıcı &amp; Özet)" Margin="0,6" FontSize="13" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkUsers" Content="👥 Kullanıcı &amp; Yetki Yönetimi (Sadece Admin)" Margin="0,6" FontSize="13" FontWeight="SemiBold"/>
                            </UniformGrid>
                        </Border>

                        <!-- 3. GRUP: KRİTİK İŞLEM VE FİNANSAL YETKİLER -->
                        <TextBlock Text="3. Özel İşlem ve Finansal Yetkiler" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                        <TextBlock Text="Satış iptalleri, fiyat değiştirme, indirim, gün sonu ve kasa/banka çıkışlarını personelin yetkisine göre sınırlandırabilirsiniz." 
                                   FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                            <UniformGrid Columns="2">
                                <CheckBox x:Name="ChkClosure" Content="🏁 Gün Sonu Kapanışı Alabilme (Z Raporu)" Margin="0,6" FontSize="13" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkCancelReceipt" Content="❌ Fiş &amp; Satış İptali Yapabilme" Margin="0,6" FontSize="13" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkManagePrices" Content="🏷️ Ürün Satış Fiyatını Değiştirme" Margin="0,6" FontSize="13" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkApplyDiscount" Content="✂️ Fiş &amp; Satır İskonto / İndirim Yapabilme" Margin="0,6" FontSize="13" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkManageDebts" Content="💳 Borç Ödeme, Kredi Kartı &amp; KMH İşlemleri" Margin="0,6" FontSize="13" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkAddCashExpense" Content="💸 Kasadan Masraf / Nakit Çıkış Girme" Margin="0,6" FontSize="13" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkDepositToBank" Content="🏦 Kasadan Bankaya Nakit Yatırma" Margin="0,6" FontSize="13" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkDeleteRecords" Content="🗑️ Geçmiş Hareket, Kayıt ve Rapor Silme" Margin="0,6" FontSize="13" FontWeight="SemiBold"/>
                            </UniformGrid>
                        </Border>

                        <!-- AKSİYON BUTONLARI -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnDeleteUser" Grid.Column="0" Content="🗑️ Kullanıcıyı Sil" Click="DeleteUser_Click"
                                    Background="#FEF2F2" Foreground="#DC2626" FontWeight="Bold" FontSize="13"
                                    Padding="16,10" BorderBrush="#FECACA" BorderThickness="1" Cursor="Hand" Visibility="Collapsed">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="İptal / Temizle" Click="ClearForm_Click" Margin="0,0,10,0"
                                        Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" FontSize="13"
                                        Padding="16,10" BorderBrush="#CBD5E1" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                </Button>

                                <Button Content="💾 Kullanıcıyı Kaydet" Click="SaveUser_Click"
                                        Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="14"
                                        Padding="24,10" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
