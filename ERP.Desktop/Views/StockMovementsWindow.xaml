<Window x:Class="ERP.Desktop.Views.StockMovementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stok Hareket Geçmişi" Height="620" Width="920"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,15"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📜 Stok Hareketleri ve Denetim Kayıtları" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Depolara yapılan alış faturası girişleri, satış çıkışları ve transfer hareketlerinin kronolojik dökümü"
                               FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🗑️ Geçmişi Temizle" Click="ClearAll_Click" Margin="0,0,10,0"
                            Background="#FEF2F2" Foreground="#DC2626" FontWeight="SemiBold" Padding="12,8"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="🔄 Yenile" Click="Refresh_Click"
                            Background="#F1F5F9" Foreground="#334155" FontWeight="Bold" Padding="16,8"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filtreler -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,15"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Depo Filtresi:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbWarehouseFilter" Width="180" Height="36" DisplayMemberPath="Name"
                          SelectionChanged="Filter_Changed" BorderBrush="#CBD5E1" Margin="0,0,20,0"/>

                <TextBlock Text="Arama:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtSearch" Width="220" Height="36" Padding="8,0" VerticalContentAlignment="Center"
                          TextChanged="Search_TextChanged" BorderBrush="#CBD5E1" ToolTip="Ürün adı, kod veya belge no ara..."/>
            </StackPanel>
        </Border>

        <!-- Hareket Tablosu -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid x:Name="MovementsGrid" AutoGenerateColumns="False" Background="White"
                      BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="40" ColumnHeaderHeight="38"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                      HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tarih / Saat" Binding="{Binding FormattedDate}" Width="130"/>
                    <DataGridTextColumn Header="Belge / Fiş No" Binding="{Binding DocumentNo}" Width="130"/>
                    <DataGridTextColumn Header="Depo" Binding="{Binding WarehouseName}" Width="120"/>
                    <DataGridTextColumn Header="Ürün" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Hareket Türü" Binding="{Binding MovementType}" Width="150"/>

                    <DataGridTemplateColumn Header="Miktar" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FormattedQuantity}" FontWeight="Bold"
                                           Foreground="{Binding BadgeColor}" VerticalAlignment="Center" Margin="10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="160"/>

                    <!-- İşlem Kolonu -->
                    <DataGridTemplateColumn Header="İşlem" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑️ Sil" Click="DeleteMovement_Click"
                                        Padding="8,4" Background="#FEF2F2" Foreground="#DC2626" FontWeight="SemiBold"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Bu stok hareket kaydını sil">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                    </Button.Resources>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
