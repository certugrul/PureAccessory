<Page x:Class="ERP.Desktop.Views.WarehouseView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F8FAFC">

    <Grid Margin="15,10,15,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Başlık -->
            <RowDefinition Height="Auto"/> <!-- İstatistik Kartları -->
            <RowDefinition Height="Auto"/> <!-- Araç Çubuğu / Filtreler -->
            <RowDefinition Height="*"/>    <!-- İçerik Sekmeleri / Tablo -->
        </Grid.RowDefinitions>

        <!-- 1. ÜST PANEL -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,15"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🏬 Depo ve Stok Yönetimi" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Çoklu depo takibi yapın, depolar arası transfer gerçekleştirin ve anlık stok durumunu izleyin"
                               FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Stok Hareketleri Butonu -->
                    <Button Content="📜 Stok Hareketleri" Click="OpenStockMovements_Click" Margin="0,0,10,0"
                            Background="#F1F5F9" Foreground="#334155" FontWeight="Bold" FontSize="13"
                            Padding="16,9" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Depolar Arası Transfer Butonu -->
                    <Button Content="🔄 Depolar Arası Transfer" Click="OpenTransfer_Click" Margin="0,0,10,0"
                            Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="13"
                            Padding="16,9" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Yeni Depo Butonu -->
                    <Button Content="➕ Yeni Depo Oluştur" Click="CreateWarehouse_Click"
                            Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="13"
                            Padding="18,9" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. İSTATİSTİK KARTLARI -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Kart 1: Depo Sayısı -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,10,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="AKTİF DEPO SAYISI" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtTotalWarehouses" Text="0" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Kart 2: Ürün Çeşidi -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,10,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ÜRÜN ÇEŞİDİ" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtTotalProductTypes" Text="0" FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Kart 3: Toplam Adet -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,10,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TOPLAM STOK ADEDİ" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtTotalStockQuantity" Text="0 Adet" FontSize="24" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Kart 4: Toplam Değer -->
            <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="18,14"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TOPLAM STOK MALİYETİ" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtTotalStockValue" Text="₺0,00" FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. FİLTRE VE ARAMA ÇUBUĞU -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,15"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Depo:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbWarehouseSelector" Width="200" Height="38" DisplayMemberPath="Name"
                              SelectionChanged="CmbWarehouseSelector_SelectionChanged" BorderBrush="#CBD5E1" Margin="0,0,20,0"/>

                    <TextBlock Text="Arama:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtSearch" Width="260" Height="38" Padding="10,0" VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged" BorderBrush="#CBD5E1" ToolTip="Ürün adı, kod veya barkod ara..."/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🔄 Yenile" Click="Refresh_Click"
                            Background="#F1F5F9" Foreground="#334155" FontWeight="Bold" Padding="16,8"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. İÇERİK SEKME KONTROLÜ (TabControl) -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
            <TabControl BorderThickness="0" Background="Transparent">
                <!-- SEKME 1: DEPO STOK LİSTESİ -->
                <TabItem Header="📦 Depo Stok Listesi" FontSize="14" FontWeight="SemiBold">
                    <DataGrid x:Name="StocksGrid" AutoGenerateColumns="False" Background="White" Margin="0,10,0,0"
                              BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="42" ColumnHeaderHeight="38"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Depo" Binding="{Binding WarehouseName}" Width="140"/>
                            <DataGridTextColumn Header="Ürün Kodu" Binding="{Binding ProductCode}" Width="110"/>
                            <DataGridTextColumn Header="Barkod" Binding="{Binding Barcode}" Width="120"/>
                            <DataGridTextColumn Header="Ürün Adı" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Mevcut Stok" Binding="{Binding FormattedQuantity}" Width="120"/>
                            <DataGridTextColumn Header="Birim Alış" Binding="{Binding FormattedPurchasePrice}" Width="110"/>
                            <DataGridTextColumn Header="Birim Satış" Binding="{Binding FormattedSalePrice}" Width="110"/>
                            <DataGridTextColumn Header="Toplam Değer" Binding="{Binding FormattedTotalValue}" Width="120"/>
                            <DataGridTextColumn Header="Durum" Binding="{Binding StockStatus}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- SEKME 2: TANIMLI DEPOLAR -->
                <TabItem Header="🏬 Tanımlı Depolar" FontSize="14" FontWeight="SemiBold">
                    <DataGrid x:Name="WarehousesGrid" AutoGenerateColumns="False" Background="White" Margin="0,10,0,0"
                              BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="42" ColumnHeaderHeight="38"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Depo Kodu" Binding="{Binding Code}" Width="110"/>
                            <DataGridTextColumn Header="Depo Adı" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="Konum / Adres" Binding="{Binding Location}" Width="200"/>
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Varsayılan" Binding="{Binding DefaultBadge}" Width="120"/>

                            <DataGridTemplateColumn Header="İşlemler" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="✏️ Düzenle" Click="EditWarehouse_Click" Margin="0,0,8,0"
                                                    Background="Transparent" Foreground="#2563EB" FontWeight="SemiBold"
                                                    BorderThickness="0" Cursor="Hand"/>
                                            <Button Content="🗑️ Sil" Click="DeleteWarehouse_Click"
                                                    Background="Transparent" Foreground="#DC2626" FontWeight="SemiBold"
                                                    BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Page>
