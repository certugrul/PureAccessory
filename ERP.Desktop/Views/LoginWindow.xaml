<Window x:Class="ERP.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pure Accessory Otomasyon — Kullanıcı Girişi"
        Icon="pack://application:,,,/ERP.Desktop;component/Assets/AppLogo.png"
        Width="500" Height="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#334155" BorderThickness="1.5"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Kapat Butonu / Üst Çubuk -->
                <RowDefinition Height="Auto"/> <!-- Logo & Başlık -->
                <RowDefinition Height="Auto"/> <!-- Dinamik Kullanıcı Kartları -->
                <RowDefinition Height="Auto"/> <!-- Şifre Giriş Alanı -->
                <RowDefinition Height="Auto"/> <!-- Butonlar -->
                <RowDefinition Height="*"/>    <!-- Alt Bilgi / İpucu -->
            </Grid.RowDefinitions>

            <!-- Üst Çubuk / Kapat -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="GÜVENLİ GİRİŞ" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <Border Background="#1E293B" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                        <TextBlock x:Name="TxtLoginVersion" Text="v1.0.7" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Border>
                </StackPanel>
                <Button Content="✕" Click="Close_Click" HorizontalAlignment="Right"
                        Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                        FontSize="16" FontWeight="Bold" Cursor="Hand" Width="28" Height="28"/>
            </Grid>

            <!-- Logo & Başlık -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Border Width="80" Height="80" CornerRadius="40" Background="White" BorderBrush="#3B82F6" BorderThickness="2.5" Margin="0,0,0,10" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/ERP.Desktop;component/Assets/AppLogo.png" 
                           Width="68" Height="68" 
                           Stretch="Uniform" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="Pure Accessory Otomasyon" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Satış &amp; Finans Yönetim Sistemi" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- DİNAMİK KULLANICI SEÇİM KARTLARI -->
            <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" Padding="10" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="UsersCardsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardBorder" MouseLeftButtonDown="UserCard_Click"
                                        Background="#0F172A" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="10"
                                        Padding="12,8" Margin="4" Cursor="Hand" MinWidth="120">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding RoleDisplayName}" FontSize="11" Foreground="#93C5FD" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding StatusDisplayName}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Şifre Giriş Alanı -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Giriş Şifresi / PIN:" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                    <TextBlock x:Name="TxtSelectedUserLabel" Text="Seçili: Yönetici (Admin)" FontSize="12" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Right"/>
                </Grid>
                <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="10" Padding="6,2">
                    <PasswordBox x:Name="TxtPassword"
                                 PasswordChar="●"
                                 FontSize="22"
                                 FontWeight="Bold"
                                 Foreground="White"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Height="44"
                                 KeyDown="TxtPassword_KeyDown"/>
                </Border>

                <!-- Hata Mesajı -->
                <TextBlock x:Name="TxtError" Text="Hatalı şifre veya kullanıcı pasif! Lütfen şifrenizi kontrol ediniz." FontSize="12" FontWeight="SemiBold"
                           Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Giriş Butonları & Yükleme Durumu -->
            <StackPanel Grid.Row="4" Margin="0,0,0,10">
                <!-- Yükleme İlerleme Durumu (Giriş yapıldığında görünür) -->
                <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" Margin="0,0,0,12">
                    <ProgressBar x:Name="PbLoading" IsIndeterminate="True" Height="6" Background="#1E293B" Foreground="#3B82F6" BorderThickness="0" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtLoadingStatus" Text="Veritabanı hazırlanıyor..." FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" TextAlignment="Center"/>
                </StackPanel>

                <Button x:Name="BtnLogin" Content="🔑 Giriş Yap" Click="Login_Click"
                        Background="#2563EB" Foreground="White" FontSize="15" FontWeight="Bold"
                        Padding="0,13" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnExit" Content="Uygulamadan Çık" Click="Close_Click"
                        Background="#1E293B" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold"
                        Padding="0,10" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!-- Alt Bilgi & DB Bağlantı Durumu -->
            <StackPanel Grid.Row="5" VerticalAlignment="Bottom">
                <!-- DB Bağlantı Çubuğu -->
                <Border Background="#1E293B" CornerRadius="8" Padding="10,7" Margin="0,0,0,6" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="DotDbStatus" Width="9" Height="9" Fill="#EAB308" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtDbStatus" Text="Veritabanı: Kontrol ediliyor..." FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="⚙️ DB Ayarla" Click="ConfigureDb_Click"
                                Background="Transparent" Foreground="#60A5FA" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Padding="6,2"/>
                    </Grid>
                </Border>

                <!-- İpucu -->
                <Border Background="#0F172A" CornerRadius="8" Padding="8,4">
                    <TextBlock Text="💡 Not: Yukarıdaki kullanıcı kartına tıklayabilir veya şifrenizle giriş yapabilirsiniz."
                               FontSize="10" Foreground="#64748B" TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
