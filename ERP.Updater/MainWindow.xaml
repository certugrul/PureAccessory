<Window x:Class="ERP.Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pure Accessory Güncelleyici"
        Height="220" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True">

    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#334155" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="18" Background="#1E293B" Margin="0,0,12,0">
                        <TextBlock Text="🔄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Pure Accessory Otomasyon" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="TxtUpdaterSub" Text="Sistem Güncelleniyor..." FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1E293B" CornerRadius="6" Padding="8,3" BorderBrush="#334155" BorderThickness="1">
                    <TextBlock x:Name="TxtUpdaterVersion" Text="v1.0.7" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                </Border>
            </Grid>

            <!-- Durum Metni -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,0">
                <TextBlock x:Name="TxtStatus" Text="Güncelleme dosyaları hazırlanıyor..." FontSize="13" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ProgressBar x:Name="ProgressBarUpdate" Height="10" IsIndeterminate="True" Background="#1E293B" Foreground="#3B82F6" BorderThickness="0">
                    <ProgressBar.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </ProgressBar.Resources>
                </ProgressBar>
            </StackPanel>

            <!-- Alt Bilgi -->
            <TextBlock Grid.Row="2" Text="Lütfen pencereyi kapatmayınız, işlem tamamlandığında uygulama açılacaktır." FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
